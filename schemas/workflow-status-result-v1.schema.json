{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.dev/contracts/workflow-status-result-v1.schema.json",
  "title": "Scherzo Cloud Workflow Status Result Schema 1",
  "oneOf": [
    { "$ref": "#/$defs/StatusSnapshot" },
    { "$ref": "#/$defs/StatusError" }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "AbsolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "LocalRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "localRunId",
        "createdAt",
        "workflowDigest",
        "workflowManifestDigest"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "localRunId": { "$ref": "#/$defs/Uuid" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "workflowDigest": { "$ref": "#/$defs/Digest" },
        "workflowManifestDigest": { "$ref": "#/$defs/Digest" }
      }
    },
    "ExecutionHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["host_boot", "isolation_instance"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "AttemptOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerNonce", "executionHost"],
      "properties": {
        "ownerNonce": { "$ref": "#/$defs/Uuid" },
        "executionHost": { "$ref": "#/$defs/ExecutionHost" }
      }
    },
    "Cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "requestedAt",
        "forceStopDeadline",
        "workflowConfirmed"
      ],
      "properties": {
        "reason": {
          "enum": [
            "user_request",
            "termination_request",
            "caller_output_failure",
            "runner_shutdown",
            "execution_lease_expired"
          ]
        },
        "requestedAt": { "$ref": "#/$defs/Timestamp" },
        "forceStopDeadline": { "$ref": "#/$defs/Timestamp" },
        "workflowConfirmed": { "type": "boolean" }
      }
    },
    "Interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "executionMayHaveStarted",
        "cancellationRequested"
      ],
      "properties": {
        "cause": {
          "enum": [
            "executor_shutdown",
            "execution_lease_expired",
            "execution_owner_lost",
            "executor_fault",
            "state_persistence_failure"
          ]
        },
        "executionMayHaveStarted": { "type": "boolean" },
        "cancellationRequested": { "type": "boolean" }
      }
    },
    "Rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "const": "immutable_specification_unusable" }
      }
    },
    "NodeRole": {
      "enum": ["step", "finalizer"]
    },
    "AttemptStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "failurePolicy", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/NodeRole" },
        "failurePolicy": { "enum": ["required", "advisory"] },
        "state": {
          "enum": [
            "pending",
            "starting",
            "running",
            "capturing_outputs",
            "cancelling",
            "succeeded",
            "failed",
            "blocked",
            "not_run",
            "cancelled"
          ]
        }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "cause"],
      "properties": {
        "phase": { "enum": ["start", "execution", "output_capture"] },
        "cause": { "$ref": "#/$defs/FailureCause" }
      }
    },
    "FailureCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "step_unavailable",
            "preparation_task_unavailable",
            "inputs_unavailable",
            "outputs_unsupported",
            "agent_runtime_unavailable",
            "agent_step_unavailable",
            "agent_admission_unavailable",
            "agent_inputs_unavailable",
            "agent_input_missing_upstream",
            "agent_input_type_mismatch",
            "agent_source_unavailable",
            "agent_source_text_invalid",
            "agent_result_schema_unavailable",
            "agent_value_mode_invalid",
            "agent_attachment_count_limit",
            "agent_attachment_bytes_limit",
            "artifact_staging_mismatch",
            "agent_staging_mismatch",
            "agent_input_staging_unavailable",
            "harness_start_failed",
            "harness_input_too_large",
            "harness_failed",
            "harness_protocol_failed",
            "missing_response",
            "missing_result",
            "result_validation_limit_exceeded",
            "captured_value_too_large",
            "result_settlement_failed",
            "input_invalid_name",
            "input_value_count_limit",
            "input_value_size_limit",
            "input_total_size_limit",
            "input_collection_ordinal_limit",
            "input_type_mismatch",
            "input_source_unavailable",
            "input_staging_unavailable",
            "input_live_limit",
            "execution_root_rebound",
            "working_directory_unavailable",
            "working_directory_escape",
            "working_directory_not_directory",
            "command_argv_invalid",
            "command_path_unconfigured",
            "executable_not_found",
            "executable_unavailable",
            "command_launch_not_found",
            "command_launch_permission_denied",
            "command_launch_invalid_input",
            "command_launch_failed",
            "command_exit",
            "command_wait_failed",
            "output_unsupported",
            "capture_task_unavailable",
            "output_path_absolute",
            "output_path_escape",
            "output_path_empty",
            "output_missing",
            "output_symbolic_link",
            "output_parent_not_directory",
            "output_not_regular_file",
            "output_source_unavailable",
            "captured_file_count_limit",
            "captured_file_size_limit",
            "captured_total_size_limit",
            "captured_git_carrier_count_limit",
            "captured_git_carrier_size_limit",
            "captured_total_git_carrier_size_limit",
            "git_execution_root_rebound",
            "git_head_unavailable",
            "git_baseline_not_ancestor",
            "git_cleanliness_unavailable",
            "git_workspace_dirty",
            "git_tree_unavailable",
            "git_required_objects_unavailable",
            "git_source_authority_changed",
            "git_structure_limit_exceeded",
            "git_command_timed_out",
            "git_bundle_generation_failed",
            "git_bundle_profile_invalid",
            "git_bundle_verification_failed",
            "git_workspace_changed",
            "git_temporary_storage_unavailable",
            "output_staging_unavailable"
          ]
        },
        "input": { "type": "string", "minLength": 1 },
        "collectionIndex": { "type": "integer", "minimum": 0 },
        "output": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "FinalizationCancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "enum": [
            "user_request",
            "termination_request",
            "caller_output_failure",
            "runner_shutdown",
            "execution_lease_expired",
            "finalization_force_abort"
          ]
        },
        "forceStopDeadline": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "DurableFinalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "failurePolicy", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "const": "finalizer" },
        "failurePolicy": { "enum": ["required", "advisory"] },
        "state": { "enum": ["succeeded", "failed", "blocked", "not_run", "cancelled"] },
        "failure": { "$ref": "#/$defs/Failure" },
        "reason": {
          "enum": [
            "user_request",
            "termination_request",
            "caller_output_failure",
            "runner_shutdown",
            "execution_lease_expired",
            "finalization_force_abort",
            "input_unavailable",
            "finalizer_trigger_not_selected"
          ]
        },
        "unavailableReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "FinalizationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalizerId", "impact"],
      "properties": {
        "finalizerId": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["required", "advisory"] }
      }
    },
    "AttemptFinalization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "trigger", "finalizers", "forceAbort"],
          "properties": {
            "complete": { "const": false },
            "trigger": { "enum": ["succeeded", "failed", "cancelled"] },
            "finalizers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/AttemptStep" },
                  { "properties": { "role": { "const": "finalizer" } } }
                ]
              }
            },
            "cancellation": { "$ref": "#/$defs/FinalizationCancellation" },
            "forceAbort": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "trigger", "finalizers", "issues", "forceAbort"],
          "properties": {
            "complete": { "const": true },
            "trigger": { "enum": ["succeeded", "failed", "cancelled"] },
            "finalizers": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/DurableFinalizer" }
            },
            "issues": {
              "type": "array",
              "items": { "$ref": "#/$defs/FinalizationIssue" }
            },
            "cancellation": { "$ref": "#/$defs/FinalizationCancellation" },
            "forceAbort": { "type": "boolean" }
          }
        }
      ]
    },
    "OutstandingAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actionId", "kind", "stepId", "nodeRole"],
          "properties": {
            "actionId": { "type": "integer", "minimum": 1 },
            "kind": {
              "enum": ["start_step", "capture_outputs", "cancel_step"]
            },
            "stepId": { "type": "string", "minLength": 1 },
            "nodeRole": { "$ref": "#/$defs/NodeRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actionId", "kind"],
          "properties": {
            "actionId": { "type": "integer", "minimum": 1 },
            "kind": { "const": "finish_run" }
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedOccurrenceOrdinal",
        "lastTransitionSequence",
        "steps",
        "outstandingActions"
      ],
      "properties": {
        "acceptedOccurrenceOrdinal": { "type": "integer", "minimum": 0 },
        "lastTransitionSequence": { "type": "integer", "minimum": 0 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/AttemptStep" },
              { "properties": { "role": { "const": "step" } } }
            ]
          }
        },
        "outstandingActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/OutstandingAction" }
        }
      }
    },
    "ProcessGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guardId",
        "actionId",
        "stepId",
        "nodeRole",
        "state",
        "executionHost",
        "processGroupId",
        "liveness"
      ],
      "properties": {
        "guardId": { "$ref": "#/$defs/Uuid" },
        "actionId": { "type": "integer", "minimum": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "nodeRole": { "$ref": "#/$defs/NodeRole" },
        "state": { "enum": ["prepared", "released", "quiesced"] },
        "executionHost": { "$ref": "#/$defs/ExecutionHost" },
        "processGroupId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "enum": ["leader_start_identity", "guard_handle_identity"]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "AttemptResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "not_published" },
            "reason": {
              "enum": [
                "attempt_nonterminal",
                "publication_pending",
                "interrupted",
                "rejected"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "relativeDirectory"],
          "properties": {
            "status": { "const": "published" },
            "relativeDirectory": {
              "type": "string",
              "pattern": "^attempts/(0{5}[1-9]|0{4}[1-9][0-9]|0{3}[1-9][0-9]{2}|0{2}[1-9][0-9]{3}|0[1-9][0-9]{4}|[1-9][0-9]{5,})/result$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "phase"],
          "properties": {
            "status": { "const": "publication_failed" },
            "phase": {
              "enum": [
                "export_copy",
                "serialization",
                "close",
                "verification",
                "rename"
              ]
            }
          }
        }
      ]
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "attemptNumber",
        "trigger",
        "state",
        "executionRoot",
        "createdAt",
        "owner",
        "progress",
        "processGuards",
        "result"
      ],
      "properties": {
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "trigger": { "enum": ["initial", "explicit_retry"] },
        "priorAttemptNumber": { "type": "integer", "minimum": 1 },
        "state": {
          "enum": [
            "created",
            "running",
            "cancelling",
            "succeeded",
            "workflow_failed",
            "cancelled",
            "interrupted",
            "rejected"
          ]
        },
        "executionRoot": { "$ref": "#/$defs/AbsolutePath" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "startedAt": { "$ref": "#/$defs/Timestamp" },
        "settledAt": { "$ref": "#/$defs/Timestamp" },
        "owner": { "$ref": "#/$defs/AttemptOwner" },
        "cancellation": { "$ref": "#/$defs/Cancellation" },
        "interruption": { "$ref": "#/$defs/Interruption" },
        "rejection": { "$ref": "#/$defs/Rejection" },
        "progress": { "$ref": "#/$defs/Progress" },
        "finalization": { "$ref": "#/$defs/AttemptFinalization" },
        "processGuards": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProcessGuard" }
        },
        "result": { "$ref": "#/$defs/AttemptResult" }
      },
      "allOf": [
        {
          "if": { "properties": { "trigger": { "const": "initial" } } },
          "then": {
            "properties": { "attemptNumber": { "const": 1 } },
            "not": { "required": ["priorAttemptNumber"] }
          },
          "else": { "required": ["priorAttemptNumber"] }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "succeeded",
                  "workflow_failed",
                  "cancelled",
                  "interrupted",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "required": ["settledAt"],
            "properties": {
              "progress": {
                "properties": {
                  "outstandingActions": { "maxItems": 0 }
                }
              }
            }
          },
          "else": { "not": { "required": ["settledAt"] } }
        },
        {
          "if": { "properties": { "state": { "const": "created" } } },
          "then": { "not": { "required": ["startedAt"] } },
          "else": {
            "if": {
              "properties": { "state": { "enum": ["running", "cancelling", "succeeded", "workflow_failed", "cancelled"] } }
            },
            "then": { "required": ["startedAt"] }
          }
        },
        {
          "if": { "properties": { "state": { "const": "interrupted" } } },
          "then": { "required": ["interruption"] },
          "else": { "not": { "required": ["interruption"] } }
        },
        {
          "if": { "properties": { "state": { "const": "rejected" } } },
          "then": { "required": ["rejection"] },
          "else": { "not": { "required": ["rejection"] } }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["cancellation"] },
              {
                "required": ["finalization"],
                "properties": {
                  "finalization": { "required": ["cancellation"] }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "interruption": {
                "properties": { "cancellationRequested": { "const": true } }
              }
            }
          },
          "else": {
            "properties": {
              "interruption": {
                "properties": { "cancellationRequested": { "const": false } }
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["cancelling", "cancelled"] } } },
          "then": {
            "anyOf": [
              { "required": ["cancellation"] },
              {
                "required": ["finalization"],
                "properties": {
                  "finalization": { "required": ["cancellation"] }
                }
              }
            ]
          }
        },
        {
          "if": { "properties": { "state": { "const": "cancelled" } } },
          "then": {
            "properties": {
              "cancellation": {
                "properties": { "workflowConfirmed": { "const": true } }
              }
            }
          },
          "else": {
            "properties": {
              "cancellation": {
                "properties": { "workflowConfirmed": { "const": false } }
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["created", "running", "cancelling"] } } },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "status": { "const": "not_published" },
                  "reason": { "const": "attempt_nonterminal" }
                },
                "required": ["status", "reason"]
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["succeeded", "workflow_failed", "cancelled"] } } },
          "then": {
            "properties": {
              "result": {
                "oneOf": [
                  {
                    "properties": {
                      "status": { "const": "not_published" },
                      "reason": { "const": "publication_pending" }
                    },
                    "required": ["status", "reason"]
                  },
                  { "properties": { "status": { "const": "published" } } },
                  { "properties": { "status": { "const": "publication_failed" } } }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "interrupted" } } },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "status": { "const": "not_published" },
                  "reason": { "const": "interrupted" }
                },
                "required": ["status", "reason"]
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "rejected" } } },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "status": { "const": "not_published" },
                  "reason": { "const": "rejected" }
                },
                "required": ["status", "reason"]
              }
            }
          }
        }
      ]
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "attemptNumber", "code"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "code": {
          "enum": [
            "stale_occurrence",
            "state_persistence_failure",
            "result_publication_failure",
            "private_cleanup_failure"
          ]
        },
        "stepId": { "type": "string", "minLength": 1 },
        "actionId": { "type": "integer", "minimum": 1 },
        "guardId": { "$ref": "#/$defs/Uuid" }
      }
    },
    "LocalRunState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "localRunId",
        "revision",
        "currentAttemptNumber",
        "attempts",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "localRunId": { "$ref": "#/$defs/Uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "currentAttemptNumber": { "type": "integer", "minimum": 1 },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Attempt" }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/Diagnostic" }
        }
      }
    },
    "Recovery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["active", "settled", "abandoned"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "guardIds", "reason"],
          "properties": {
            "status": { "const": "ownership_unproven" },
            "guardIds": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/Uuid" }
            },
            "reason": {
              "enum": [
                "execution_host_identity_unavailable",
                "process_identity_inspection_unavailable"
              ]
            }
          }
        }
      ]
    },
    "Retry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible"],
          "properties": {
            "eligible": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible", "reason"],
          "properties": {
            "eligible": { "const": false },
            "reason": {
              "enum": [
                "run_locked",
                "latest_attempt_succeeded",
                "latest_attempt_rejected",
                "ownership_unproven"
              ]
            }
          }
        }
      ]
    },
    "StatusSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "runDirectory",
        "run",
        "state",
        "recovery",
        "retry"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "scherzo-cloud workflow status" },
        "outcome": { "const": "status" },
        "exitStatus": { "const": 0 },
        "runDirectory": { "$ref": "#/$defs/AbsolutePath" },
        "run": { "$ref": "#/$defs/LocalRun" },
        "state": { "$ref": "#/$defs/LocalRunState" },
        "recovery": { "$ref": "#/$defs/Recovery" },
        "retry": { "$ref": "#/$defs/Retry" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recovery": {
                "properties": { "status": { "const": "active" } },
                "required": ["status"]
              }
            }
          },
          "then": {
            "properties": {
              "retry": {
                "properties": {
                  "eligible": { "const": false },
                  "reason": { "const": "run_locked" }
                },
                "required": ["eligible", "reason"]
              }
            }
          }
        }
      ]
    },
    "StatusError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "error"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "scherzo-cloud workflow status" },
        "outcome": { "const": "error" },
        "exitStatus": { "const": 1 },
        "runDirectory": { "$ref": "#/$defs/AbsolutePath" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "run_directory_unavailable",
                "run_directory_invalid",
                "lock_query_failed",
                "status_snapshot_unstable"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
