"""Exercise public allocation verification and mocked GitHub reconciliation."""

from __future__ import annotations

import base64
import gzip
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
from dataclasses import dataclass
from pathlib import Path
from types import ModuleType
from typing import Mapping, Sequence

ROOT = Path(__file__).resolve().parents[1]
VERIFIER = ROOT / "scripts/verify-release-allocation"
RECONCILER = ROOT / "scripts/reconcile-release"
REPOSITORY_NAME = "fixture/scherzo-cloud-cli"


def fail(message: str) -> None:
    print(f"CLI release-allocation fixture failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(
    arguments: Sequence[str | Path],
    *,
    cwd: Path | None = None,
    environment: Mapping[str, str] | None = None,
    input_bytes: bytes | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(
        [os.fspath(argument) for argument in arguments],
        cwd=cwd,
        env=dict(environment or os.environ),
        input=input_bytes,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and result.returncode != 0:
        fail(
            f"command failed ({' '.join(map(os.fspath, arguments))}): "
            + result.stderr.decode("utf-8", "replace").strip()
        )
    return result


def load_verifier() -> ModuleType:
    loader = importlib.machinery.SourceFileLoader("fixture_release_verifier", os.fspath(VERIFIER))
    specification = importlib.util.spec_from_loader(loader.name, loader)
    if specification is None:
        fail("cannot load allocation verifier")
    module = importlib.util.module_from_spec(specification)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def git(repository: Path, *arguments: str, input_bytes: bytes | None = None) -> bytes:
    environment = {
        **os.environ,
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_CONFIG_NOSYSTEM": "1",
        "LC_ALL": "C",
    }
    return run(
        ["git", "-C", repository, *arguments],
        environment=environment,
        input_bytes=input_bytes,
    ).stdout


def commit_tree(
    repository: Path,
    tree: str,
    message: bytes,
    *,
    parent: str | None,
    identity: str,
    email: str,
    epoch: bool = True,
) -> str:
    arguments = ["git", "-C", repository, "commit-tree", tree]
    if parent is not None:
        arguments.extend(("-p", parent))
    environment = {
        **os.environ,
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_AUTHOR_NAME": identity,
        "GIT_AUTHOR_EMAIL": email,
        "GIT_COMMITTER_NAME": identity,
        "GIT_COMMITTER_EMAIL": email,
        "GIT_AUTHOR_DATE": "@0 +0000" if epoch else "@1 +0000",
        "GIT_COMMITTER_DATE": "@0 +0000" if epoch else "@1 +0000",
        "LC_ALL": "C",
    }
    return run(arguments, environment=environment, input_bytes=message).stdout.decode("ascii").strip()


def record_commit(
    module: ModuleType,
    repository: Path,
    subject: str,
    plan_name: str,
    plan: bytes,
    payload_name: str,
    payload: bytes,
) -> str:
    bound = {plan_name: plan, payload_name: payload}
    files = {**bound, "files.sha256": module.digest_manifest(bound)}
    lines = []
    for name in sorted(files, key=os.fsencode):
        object_id = git(repository, "hash-object", "-w", "--stdin", input_bytes=files[name]).decode().strip()
        lines.append(f"100644 blob {object_id}\t{name}\n")
    tree = git(repository, "mktree", input_bytes="".join(lines).encode("ascii")).decode().strip()
    return commit_tree(
        repository,
        tree,
        f"{subject}\n".encode("ascii"),
        parent=None,
        identity="Scherzo Release Record",
        email="noreply@scherzo.dev",
    )


def canonical_diff(repository: Path, base: str, candidate: str) -> bytes:
    return git(
        repository,
        "-c",
        "core.attributesFile=/dev/null",
        "-c",
        "diff.algorithm=myers",
        "-c",
        "diff.context=3",
        "-c",
        "diff.indentHeuristic=false",
        "-c",
        "diff.interHunkContext=0",
        "-c",
        "diff.mnemonicPrefix=false",
        "-c",
        "diff.noprefix=false",
        "-c",
        "diff.orderFile=/dev/null",
        "-c",
        "diff.renames=false",
        "-c",
        "diff.submodule=short",
        "diff",
        "--no-color",
        "--full-index",
        "--binary",
        "--no-ext-diff",
        "--no-textconv",
        "--no-renames",
        "--src-prefix=a/",
        "--dst-prefix=b/",
        base,
        candidate,
    )


def release_document(
    module: ModuleType,
    tag: str,
    *,
    commit: str,
    body: str,
    identifier: int,
) -> dict[str, object]:
    assets = []
    for index, name in enumerate(module.expected_asset_names(tag.removeprefix("v")), start=1):
        value = f"prior-{name}".encode("ascii")
        assets.append(
            {
                "id": identifier * 100 + index,
                "name": name,
                "size": len(value),
                "digest": f"sha256:{hashlib.sha256(value).hexdigest()}",
                "bytes": base64.b64encode(value).decode("ascii"),
            }
        )
    return {
        "id": identifier,
        "tag_name": tag,
        "target_commitish": commit,
        "name": f"Scherzo Cloud CLI {tag}",
        "body": body,
        "published_at": "2026-08-08T00:00:00Z",
        "draft": False,
        "prerelease": False,
        "assets": assets,
    }


@dataclass
class Fixture:
    module: ModuleType
    root: Path
    source: Path
    remote: Path
    checkout: Path
    fake_bin: Path
    state_path: Path
    base: str
    allocated: str
    allocation_commit: str
    plan_digest: str
    current: str
    recovery_digests: tuple[str, ...]

    @property
    def environment(self) -> dict[str, str]:
        return {
            **os.environ,
            "PATH": f"{self.fake_bin}:{os.environ['PATH']}",
            "GH_TOKEN": "fixture-token",
            "SCHERZO_MOCK_GH_STATE": os.fspath(self.state_path),
        }

    def state(self) -> dict[str, object]:
        return json.loads(self.state_path.read_text())

    def write_state(self, value: Mapping[str, object]) -> None:
        self.state_path.write_text(json.dumps(value, sort_keys=True))

    def reset_provider(self) -> None:
        prior = release_document(
            self.module,
            "v0.1.0",
            commit=self.base,
            body="Prior fixture release.\n",
            identifier=10,
        )
        self.write_state(
            {
                "git_remote": os.fspath(self.remote),
                "tags": {"v0.1.0": self.base},
                "releases": [prior],
                "next_release_id": 20,
                "next_asset_id": 2000,
                "writes": [],
                "fail_upload_once": False,
            }
        )
        git(self.remote, "update-ref", "-d", "refs/tags/v0.1.1")
        git(self.checkout, "update-ref", "-d", "refs/tags/v0.1.1")

    def add_target_tag(self, commit: str | None = None) -> None:
        target = commit or self.allocated
        state = self.state()
        state["tags"]["v0.1.1"] = target
        self.write_state(state)
        git(self.remote, "update-ref", "refs/tags/v0.1.1", target)
        git(self.checkout, "fetch", "--force", "--no-tags", "origin", "refs/tags/v0.1.1:refs/tags/v0.1.1")

    def set_draft(
        self,
        assets: Sequence[dict[str, object]] = (),
        *,
        body: str = "## Fixed\n\n- Fix exact allocation execution.\n",
    ) -> None:
        self.add_target_tag()
        state = self.state()
        state["releases"].append(
            {
                "id": 20,
                "tag_name": "v0.1.1",
                "target_commitish": self.allocated,
                "name": "Scherzo Cloud CLI v0.1.1",
                "body": body,
                "published_at": "",
                "draft": True,
                "prerelease": False,
                "assets": list(assets),
            }
        )
        self.write_state(state)


def write_public_tree(source: Path, *, defective: bool) -> None:
    (source / "scripts").mkdir(parents=True)
    (source / ".github/workflows").mkdir(parents=True)
    (source / "src").mkdir(parents=True)
    (source / "tests/fixtures/release-notes/allocation").mkdir(parents=True)
    (source / "release.toml").write_bytes(ROOT.joinpath("release.toml").read_bytes())
    (source / "Cargo.toml").write_text('[package]\nname = "fixture"\nversion = "0.0.0-dev"\n')
    (source / "README.md").write_text("Fixture README.\n")
    (source / "LICENSE").write_text("Fixture license.\n")
    (source / "src/main.rs").write_text("fn main() {}\n")
    (source / ".github/workflows/check.yml").write_text("name: Fixture release\n")
    verifier = source / "scripts/verify-release-allocation"
    if defective:
        verifier.write_text("#!/bin/sh\nexit 23\n")
    else:
        verifier.write_bytes(VERIFIER.read_bytes())
    verifier.chmod(0o755)
    reconciler = source / "scripts/reconcile-release"
    reconciler.write_bytes(RECONCILER.read_bytes())
    reconciler.chmod(0o755)
    (source / "scripts/test-release-allocation").write_text("fixture evidence\n")
    (source / "tests/fixtures/release-notes/allocation/case.txt").write_text("fixture\n")


def build_fixture(module: ModuleType, root: Path, *, recoveries: int = 0, tamper: str = "") -> Fixture:
    root.mkdir()
    source = root / "source"
    source.mkdir()
    git(source, "init", "--quiet", "--initial-branch=main")
    git(source, "config", "user.name", "Fixture")
    git(source, "config", "user.email", "fixture@scherzo.invalid")
    write_public_tree(source, defective=recoveries > 0)
    git(source, "add", "--all")
    base_tree = git(source, "write-tree").decode().strip()
    base_source = "b" * 40
    legacy_digest = hashlib.sha256(b"legacy-plan\n").hexdigest()
    base = commit_tree(
        source,
        base_tree,
        (
            "Mirror CLI source\n\n"
            f"Source-Revision: {base_source}\n"
            f"Release-Plan-Digest: {legacy_digest}\n"
        ).encode("ascii"),
        parent=None,
        identity="Scherzo Cloud Mirror",
        email="mirror@scherzo.dev",
        epoch=False,
    )
    (source / "src/main.rs").write_text("fn main() { println!(\"allocated\"); }\n")
    git(source, "add", "--all")
    allocated_tree = git(source, "write-tree").decode().strip()
    prior = release_document(
        module,
        "v0.1.0",
        commit=base,
        body="Prior fixture release.\n",
        identifier=10,
    )
    stable = f"refs/tags/v0.1.0={base}\n".encode("ascii")
    latest = module.normalize_latest_release("v0.1.0", base, prior)
    notes = b"## Fixed\n\n- Fix exact allocation execution.\n"
    source_revision = "a" * 40
    plan = module.serialize(
        (
            ("contract", "2"),
            ("source_revision", source_revision),
            ("cli_tree", allocated_tree),
            ("policy_sha256", module.sha256(module.POLICY)),
            ("journal_sha256", "1" * 64),
            ("public_base_commit", base),
            ("public_base_source_revision", base_source),
            ("stable_refs_sha256", module.sha256(stable)),
            ("latest_stable_tag", "v0.1.0"),
            ("latest_stable_commit", base),
            ("latest_stable_source_revision", base_source),
            ("latest_release_sha256", module.sha256(latest)),
            ("release", "true"),
            ("reason", "releaseable-changes"),
            ("impact", "patch"),
            ("version", "0.1.1"),
            ("tag", "v0.1.1"),
            ("changelog_sha256", module.sha256(notes)),
            ("source_evidence_sha256", "2" * 64),
        )
    )
    plan_digest = module.sha256(plan)
    allocation_commit = record_commit(
        module,
        source,
        "Reserve CLI release v0.1.1",
        "release-plan.txt",
        plan,
        "rendered-notes.md",
        notes,
    )
    allocated = commit_tree(
        source,
        allocated_tree,
        (
            "Mirror CLI source\n\n"
            f"Source-Revision: {source_revision}\n"
            f"Release-Plan-Digest: {plan_digest}\n"
            f"Release-Allocation-Ref: {module.ALLOCATION_PREFIX}{plan_digest}\n"
            f"Release-Allocation-Commit: {allocation_commit}\n"
        ).encode("ascii"),
        parent=base,
        identity="Scherzo Cloud Mirror",
        email="mirror@scherzo.dev",
    )
    current = allocated
    recovery_digests: list[str] = []
    previous = "none"
    for index in range(recoveries):
        if index == 0:
            (source / "scripts/verify-release-allocation").write_bytes(VERIFIER.read_bytes())
            (source / "scripts/verify-release-allocation").chmod(0o755)
        else:
            (source / ".github/workflows/check.yml").write_text(
                f"name: Fixture recovery {index + 1}\n"
            )
        if tamper == "source" and index == recoveries - 1:
            (source / "src/main.rs").write_text("fn main() { println!(\"tampered\"); }\n")
        git(source, "add", "--all")
        repair_tree = git(source, "write-tree").decode().strip()
        patch = canonical_diff(source, allocated, repair_tree)
        recovery_plan = module.serialize(
            (
                ("contract", "1"),
                ("allocation_plan_digest", plan_digest),
                ("allocation_ref", module.ALLOCATION_PREFIX + plan_digest),
                ("allocation_commit", allocation_commit),
                ("allocated_mirror_commit", allocated),
                ("allocated_source_revision", source_revision),
                ("version", "0.1.1"),
                ("tag", "v0.1.1"),
                ("public_base_commit", current),
                (
                    "previous_recovery_digest",
                    "f" * 64 if tamper == "predecessor" and index == recoveries - 1 else previous,
                ),
                ("repair_source_revision", f"{index + 3:040x}"),
                ("repair_cli_tree", repair_tree),
                ("repair_patch_sha256", module.sha256(patch)),
                ("repair_evidence_sha256", f"{index + 4:064x}"),
            )
        )
        recovery_digest = module.sha256(recovery_plan)
        recovery_commit = record_commit(
            module,
            source,
            f"Reserve CLI recovery {recovery_digest}",
            "release-recovery-plan.txt",
            recovery_plan,
            "repair.patch",
            patch,
        )
        current = commit_tree(
            source,
            repair_tree,
            (
                "Mirror CLI recovery\n\n"
                f"Source-Revision: {index + 3:040x}\n"
                f"Release-Plan-Digest: {plan_digest}\n"
                f"Release-Allocation-Ref: {module.ALLOCATION_PREFIX}{plan_digest}\n"
                f"Release-Allocation-Commit: {allocation_commit}\n"
                f"Allocated-Mirror-Commit: {allocated}\n"
                f"Release-Recovery-Digest: {recovery_digest}\n"
                f"Release-Recovery-Ref: {module.RECOVERY_PREFIX}{recovery_digest}\n"
                f"Release-Recovery-Commit: {recovery_commit}\n"
            ).encode("ascii"),
            parent=current,
            identity="Scherzo Cloud Mirror",
            email="mirror@scherzo.dev",
        )
        recovery_digests.append(recovery_digest)
        previous = recovery_digest
    git(source, "update-ref", "refs/heads/main", current)
    git(source, "update-ref", "refs/tags/v0.1.0", base)
    git(source, "update-ref", module.ALLOCATION_PREFIX + plan_digest, allocation_commit)
    # Record refs are recoverable from each recovery mirror trailer.
    cursor = current
    for recovery_digest in reversed(recovery_digests):
        message = git(source, "show", "-s", "--format=%B", cursor).decode("ascii")
        recovery_commit = next(
            line.split(": ", 1)[1]
            for line in message.splitlines()
            if line.startswith("Release-Recovery-Commit: ")
        )
        git(source, "update-ref", module.RECOVERY_PREFIX + recovery_digest, recovery_commit)
        cursor = git(source, "rev-parse", f"{cursor}^1").decode().strip()
    remote = root / "remote.git"
    git(root, "clone", "--quiet", "--bare", source, remote)
    checkout = root / "checkout"
    git(root, "clone", "--quiet", "--no-local", "--branch=main", remote, checkout)
    git(checkout, "fetch", "--force", "--no-tags", "origin", f"{module.ALLOCATION_PREFIX}*:{module.ALLOCATION_PREFIX}*")
    if recovery_digests:
        git(checkout, "fetch", "--force", "--no-tags", "origin", f"{module.RECOVERY_PREFIX}*:{module.RECOVERY_PREFIX}*")
    fake_bin = root / "bin"
    fake_bin.mkdir()
    write_fake_gh(fake_bin / "gh")
    state_path = root / "github.json"
    fixture = Fixture(
        module,
        root,
        source,
        remote,
        checkout,
        fake_bin,
        state_path,
        base,
        allocated,
        allocation_commit,
        plan_digest,
        current,
        tuple(recovery_digests),
    )
    fixture.reset_provider()
    return fixture


def write_fake_gh(path: Path) -> None:
    path.write_text(
        f"#!{sys.executable}\n"
        + """import base64
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

state_path = Path(os.environ["SCHERZO_MOCK_GH_STATE"])
state = json.loads(state_path.read_text())
args = sys.argv[1:]

def save():
    state_path.write_text(json.dumps(state, sort_keys=True))

def public_release(release):
    return {key: value for key, value in release.items() if key != "_private"}

def die404():
    print("gh: HTTP 404 Not Found", file=sys.stderr)
    raise SystemExit(1)

def option(name):
    return args[args.index(name) + 1]

if args[:2] == ["attestation", "verify"]:
    raise SystemExit(0)

if args[0] == "api":
    api_args = args[1:]
    endpoint = api_args[-1]
    if "/releases/assets/" in endpoint:
        identifier = int(endpoint.rsplit("/", 1)[1])
        for release in state["releases"]:
            for asset in release["assets"]:
                if asset["id"] == identifier:
                    sys.stdout.buffer.write(base64.b64decode(asset["bytes"]))
                    raise SystemExit(0)
        die404()
    if "/git/ref/tags/" in endpoint:
        tag = endpoint.rsplit("/", 1)[1]
        target = state["tags"].get(tag)
        if target is None:
            die404()
        print(json.dumps({"ref": f"refs/tags/{tag}", "object": {"type": "commit", "sha": target}}))
        raise SystemExit(0)
    if "/releases/tags/" in endpoint:
        tag = endpoint.rsplit("/", 1)[1]
        matches = [release for release in state["releases"] if release["tag_name"] == tag and not release["draft"]]
        if not matches:
            die404()
        print(json.dumps(public_release(matches[0])))
        raise SystemExit(0)
    if endpoint.endswith("/releases?per_page=100"):
        releases = state["releases"][:100]
        print(json.dumps([public_release(release) for release in releases]))
        raise SystemExit(0)
    if "/releases?per_page=100&page=" in endpoint:
        raw_page = endpoint.rsplit("=", 1)[1]
        if not raw_page.isdecimal() or int(raw_page) < 1:
            raise SystemExit("invalid releases page: " + raw_page)
        page = int(raw_page)
        start = (page - 1) * 100
        releases = state["releases"][start:start + 100]
        print(json.dumps([public_release(release) for release in releases]))
        raise SystemExit(0)
    raise SystemExit("unsupported mock gh api: " + endpoint)

if args[:2] == ["release", "create"]:
    tag = args[2]
    if any(release["tag_name"] == tag for release in state["releases"]):
        raise SystemExit("release already exists")
    target = option("--target")
    if "--verify-tag" in args:
        if state["tags"].get(tag) != target:
            raise SystemExit("tag target differs")
    else:
        if tag in state["tags"]:
            raise SystemExit("tag already exists")
        state["tags"][tag] = target
        subprocess.run(["git", f"--git-dir={state['git_remote']}", "update-ref", f"refs/tags/{tag}", target], check=True)
    release = {
        "id": state["next_release_id"],
        "tag_name": tag,
        "target_commitish": target,
        "name": option("--title"),
        "body": Path(option("--notes-file")).read_text(),
        "published_at": "",
        "draft": True,
        "prerelease": False,
        "assets": [],
    }
    state["next_release_id"] += 1
    state["releases"].append(release)
    state["writes"].append("create-draft")
    save()
    raise SystemExit(0)

if args[:2] == ["release", "upload"]:
    tag = args[2]
    release = next(release for release in state["releases"] if release["tag_name"] == tag)
    start = args.index("--repo") + 2
    paths = args[start:]
    for index, raw_path in enumerate(paths):
        path = Path(raw_path)
        value = path.read_bytes()
        release["assets"].append({
            "id": state["next_asset_id"],
            "name": path.name,
            "size": len(value),
            "digest": "sha256:" + hashlib.sha256(value).hexdigest(),
            "bytes": base64.b64encode(value).decode("ascii"),
        })
        state["next_asset_id"] += 1
        state["writes"].append("upload:" + path.name)
        if state.get("fail_upload_once") and index == 0:
            state["fail_upload_once"] = False
            save()
            raise SystemExit("injected transient upload failure")
    save()
    raise SystemExit(0)

if args[:2] == ["release", "edit"]:
    tag = args[2]
    release = next(release for release in state["releases"] if release["tag_name"] == tag)
    release["draft"] = False
    release["published_at"] = "2026-08-09T00:00:00Z"
    state["writes"].append("publish")
    save()
    raise SystemExit(0)

raise SystemExit("unsupported mock gh invocation: " + " ".join(args))
"""
    )
    path.chmod(0o755)


def run_verifier(
    fixture: Fixture,
    *,
    event: str = "push",
    allocated: str = "auto",
    check: bool = True,
) -> subprocess.CompletedProcess[bytes]:
    output = fixture.root / f"verification-{len(list(fixture.root.glob('verification-*')))}"
    return run(
        [
            VERIFIER,
            "--repository",
            fixture.checkout,
            "--allocated-mirror",
            allocated,
            "--workflow-commit",
            fixture.current,
            "--event",
            event,
            "--github-repository",
            REPOSITORY_NAME,
            "--output",
            output,
        ],
        environment=fixture.environment,
        check=check,
    )


def reconciliation_command(
    fixture: Fixture,
    dist: Path,
    operation: str,
    *,
    event: str = "push",
    allocated: str | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[bytes]:
    return run(
        [
            RECONCILER,
            operation,
            "--repository",
            fixture.checkout,
            "--allocated-mirror",
            allocated or fixture.allocated,
            "--workflow-commit",
            fixture.current,
            "--event",
            event,
            "--github-repository",
            REPOSITORY_NAME,
            "--dist",
            dist,
        ],
        environment=fixture.environment,
        check=check,
    )


def make_dist(root: Path, version: str = "0.1.1") -> Path:
    dist = root / "dist"
    dist.mkdir()
    targets = (
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    )
    archives: list[Path] = []
    for target in targets:
        package = f"scherzo-cloud-{version}-{target}"
        archive_path = dist / f"{package}.tar.gz"
        with archive_path.open("wb") as output:
            with gzip.GzipFile(filename="", mode="wb", fileobj=output, mtime=0) as compressed:
                with tarfile.open(fileobj=compressed, mode="w", format=tarfile.USTAR_FORMAT) as archive:
                    directory = tarfile.TarInfo(f"{package}/")
                    directory.type = tarfile.DIRTYPE
                    directory.mode = 0o755
                    directory.mtime = directory.uid = directory.gid = 0
                    directory.uname = directory.gname = ""
                    archive.addfile(directory)
                    for name, value, mode in (
                        ("LICENSE", b"fixture license\n", 0o644),
                        ("README.md", b"fixture readme\n", 0o644),
                        ("scherzo-cloud", f"binary-{target}\n".encode("ascii"), 0o755),
                    ):
                        member = tarfile.TarInfo(f"{package}/{name}")
                        member.size = len(value)
                        member.mode = mode
                        member.mtime = member.uid = member.gid = 0
                        member.uname = member.gname = ""
                        archive.addfile(member, io.BytesIO(value))
        archives.append(archive_path)
    checksum_lines = b"".join(
        f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.name}\n".encode("ascii")
        for path in sorted(archives, key=lambda path: os.fsencode(path.name))
    )
    (dist / "SHA256SUMS").write_bytes(checksum_lines)
    return dist


def local_asset(dist: Path, name: str, identifier: int, *, changed: bool = False) -> dict[str, object]:
    value = (b"changed" if changed else (dist / name).read_bytes())
    return {
        "id": identifier,
        "name": name,
        "size": len(value),
        "digest": f"sha256:{hashlib.sha256(value).hexdigest()}",
        "bytes": base64.b64encode(value).decode("ascii"),
    }


def assert_no_write(fixture: Fixture, action: callable, description: str) -> None:
    before = fixture.state()["writes"]
    result = action()
    if result.returncode == 0:
        fail(f"{description} unexpectedly succeeded")
    if fixture.state()["writes"] != before:
        fail(f"{description} changed mocked GitHub state")


def prove_normal_execution(module: ModuleType, root: Path) -> None:
    fixture = build_fixture(module, root / "normal")
    dist = make_dist(fixture.root)
    verified = run_verifier(fixture)
    if b"(absent)" not in verified.stdout:
        fail("normal allocation did not verify absent provider state")
    writes = list(fixture.state()["writes"])
    reconciliation_command(fixture, dist, "inspect")
    if fixture.state()["writes"] != writes:
        fail("reconciliation inspection wrote provider state")
    reconciliation_command(fixture, dist, "apply")
    state = fixture.state()
    target_release = next(release for release in state["releases"] if release["tag_name"] == "v0.1.1")
    if (
        state["tags"].get("v0.1.1") != fixture.allocated
        or target_release["draft"]
        or [asset["name"] for asset in target_release["assets"]]
        != module.expected_asset_names("0.1.1")
    ):
        fail("normal reconciliation did not publish the exact allocation")
    completed = run_verifier(fixture)
    if b"(published)" not in completed.stdout:
        fail("exact published release was not verified as complete")
    writes = list(fixture.state()["writes"])
    reconciliation_command(fixture, dist, "apply")
    if fixture.state()["writes"] != writes:
        fail("exact published reconciliation was not a no-op")


def prove_partial_and_transient(module: ModuleType, root: Path) -> None:
    partial = build_fixture(module, root / "partial")
    dist = make_dist(partial.root)
    partial.add_target_tag()
    reconciliation_command(partial, dist, "apply")
    if partial.state()["tags"]["v0.1.1"] != partial.allocated:
        fail("partial-tag reconciliation moved the allocated tag")

    draft = build_fixture(module, root / "draft")
    draft_dist = make_dist(draft.root)
    first_name = module.expected_asset_names("0.1.1")[0]
    draft.set_draft([local_asset(draft_dist, first_name, 3000)])
    reconciliation_command(draft, draft_dist, "apply")
    if next(release for release in draft.state()["releases"] if release["tag_name"] == "v0.1.1")["draft"]:
        fail("matching draft did not reconcile")

    transient = build_fixture(module, root / "transient")
    transient_dist = make_dist(transient.root)
    state = transient.state()
    state["fail_upload_once"] = True
    transient.write_state(state)
    failed = reconciliation_command(transient, transient_dist, "apply", check=False)
    if failed.returncode == 0:
        fail("injected transient upload did not interrupt reconciliation")
    pending = next(release for release in transient.state()["releases"] if release["tag_name"] == "v0.1.1")
    if not pending["draft"] or len(pending["assets"]) != 1:
        fail("transient failure did not retain one matching partial draft")
    reconciliation_command(transient, transient_dist, "apply")
    if next(release for release in transient.state()["releases"] if release["tag_name"] == "v0.1.1")["draft"]:
        fail("transient retry did not complete the same allocation")


def prove_paginated_target_release(module: ModuleType, root: Path) -> None:
    fixture = build_fixture(module, root / "paginated")
    dist = make_dist(fixture.root)
    fixture.set_draft()
    state = fixture.state()
    target = state["releases"].pop()
    decoys = [
        {
            "id": 1000 + index,
            "tag_name": f"fixture-decoy-{index}",
            "target_commitish": fixture.base,
            "name": f"Fixture decoy {index}",
            "body": "Fixture pagination decoy.\n",
            "published_at": "2026-08-08T00:00:00Z",
            "draft": False,
            "prerelease": False,
            "assets": [],
        }
        for index in range(99)
    ]
    state["releases"].extend(decoys)
    state["releases"].append(target)
    fixture.write_state(state)

    inspected = reconciliation_command(fixture, dist, "inspect")
    if b"draft provider state" not in inspected.stdout:
        fail("target draft beyond the first release page was not inspected")
    reconciliation_command(fixture, dist, "apply")
    writes = list(fixture.state()["writes"])
    reconciliation_command(fixture, dist, "apply")
    if fixture.state()["writes"] != writes:
        fail("paginated exact published release was not a no-op")


def prove_conflicts(module: ModuleType, root: Path) -> None:
    changed = build_fixture(module, root / "changed")
    changed_dist = make_dist(changed.root)
    name = module.expected_asset_names("0.1.1")[0]
    changed.set_draft([local_asset(changed_dist, name, 4000, changed=True)])
    assert_no_write(
        changed,
        lambda: reconciliation_command(changed, changed_dist, "inspect", check=False),
        "changed draft asset",
    )

    extra = build_fixture(module, root / "extra")
    extra_dist = make_dist(extra.root)
    extra.set_draft(
        [
            {
                "id": 4100,
                "name": "unexpected.txt",
                "size": 1,
                "digest": f"sha256:{hashlib.sha256(b'x').hexdigest()}",
                "bytes": base64.b64encode(b"x").decode("ascii"),
            }
        ]
    )
    assert_no_write(
        extra,
        lambda: reconciliation_command(extra, extra_dist, "inspect", check=False),
        "unexpected draft asset",
    )

    body = build_fixture(module, root / "body")
    body_dist = make_dist(body.root)
    body.set_draft(body="Changed release notes.\n")
    assert_no_write(
        body,
        lambda: reconciliation_command(body, body_dist, "inspect", check=False),
        "conflicting draft body",
    )

    wrong = build_fixture(module, root / "wrong")
    wrong_dist = make_dist(wrong.root)
    wrong.add_target_tag(wrong.base)
    assert_no_write(
        wrong,
        lambda: reconciliation_command(wrong, wrong_dist, "inspect", check=False),
        "wrong stable-tag target",
    )

    live_race = build_fixture(module, root / "live-race")
    live_race_dist = make_dist(live_race.root)
    live_race.set_draft()
    state = live_race.state()
    state["tags"]["v0.1.1"] = live_race.base
    live_race.write_state(state)
    assert_no_write(
        live_race,
        lambda: reconciliation_command(live_race, live_race_dist, "apply", check=False),
        "live stable-tag movement after the verified Git fetch",
    )

    movement = build_fixture(module, root / "movement")
    movement_dist = make_dist(movement.root)
    git(movement.checkout, "update-ref", "refs/tags/v0.0.9", movement.base)
    assert_no_write(
        movement,
        lambda: reconciliation_command(movement, movement_dist, "inspect", check=False),
        "unrelated stable-ref movement",
    )


def prove_recovery(module: ModuleType, root: Path) -> None:
    recovery = build_fixture(module, root / "recovery", recoveries=1)
    dist = make_dist(recovery.root)
    failed_executor = run(
        ["git", "-C", recovery.checkout, "show", f"{recovery.allocated}:scripts/verify-release-allocation"],
        check=True,
    ).stdout
    defect = recovery.root / "defective-verifier"
    defect.write_bytes(failed_executor)
    defect.chmod(0o755)
    before = list(recovery.state()["writes"])
    if run([defect], check=False).returncode == 0:
        fail("deterministic allocated verifier defect did not fail ordinary retry")
    if recovery.state()["writes"] != before:
        fail("ordinary defective retry changed mocked GitHub state")
    push = run_verifier(recovery, event="push", allocated="auto")
    verification_path = sorted(recovery.root.glob("verification-*"))[-1] / "verification.txt"
    fields = dict(line.split("=", 1) for line in verification_path.read_text().splitlines())
    if fields["execute"] != "false" or fields["recovery_digest"] != recovery.recovery_digests[-1]:
        fail("recovery-mirror push was not verified as read-only")
    if not push.stdout:
        fail("recovery-mirror verification produced no result")
    run_verifier(recovery, event="recovery", allocated=recovery.allocated)
    reconciliation_command(
        recovery,
        dist,
        "apply",
        event="recovery",
        allocated=recovery.allocated,
    )
    if recovery.state()["tags"].get("v0.1.1") != recovery.allocated:
        fail("recovery tagged the repair mirror instead of the original allocation")
    writes = list(recovery.state()["writes"])
    reconciliation_command(
        recovery,
        dist,
        "apply",
        event="recovery",
        allocated=recovery.allocated,
    )
    if recovery.state()["writes"] != writes:
        fail("repeated valid recovery was not an exact no-op")

    chained = build_fixture(module, root / "chained", recoveries=2)
    run_verifier(chained, event="recovery", allocated=chained.allocated)
    if len(chained.recovery_digests) != 2:
        fail("chained recovery fixture did not retain two records")
    assert_no_write(
        chained,
        lambda: run_verifier(chained, event="recovery", allocated="0" * 40, check=False),
        "changed original allocation input",
    )

    predecessor = build_fixture(module, root / "predecessor", recoveries=2, tamper="predecessor")
    assert_no_write(
        predecessor,
        lambda: run_verifier(
            predecessor,
            event="recovery",
            allocated=predecessor.allocated,
            check=False,
        ),
        "bad recovery predecessor",
    )

    source = build_fixture(module, root / "source-tamper", recoveries=1, tamper="source")
    assert_no_write(
        source,
        lambda: run_verifier(source, event="recovery", allocated=source.allocated, check=False),
        "non-allowlisted recovery repair",
    )


def prove_stable_manifest_order(module: ModuleType) -> None:
    refs = {
        "v0.2.1": "1" * 40,
        "v0.2.10": "2" * 40,
    }
    expected = (
        f"refs/tags/v0.2.10={'2' * 40}\n"
        f"refs/tags/v0.2.1={'1' * 40}\n"
    ).encode("ascii")
    if module.stable_manifest(refs) != expected:
        fail("stable-ref manifest is not C-sorted by complete rendered records")


def prove_workflow_contract(module: ModuleType) -> None:
    workflow = ROOT.joinpath(".github/workflows/check.yml").read_text()
    required = (
        'branches-ignore:\n      - "release-allocations/**"\n      - "release-recoveries/**"',
        "verify_release:",
        "build_release:",
        "reconcile_release:",
        "ref: ${{ needs.verify_release.outputs.allocated_mirror }}",
        "contents: write",
        "actions/attest-build-provenance@0f67c3f4856b2e3261c31976d6725780e5e4c373",
        "ubuntu-24.04-arm",
        "macos-15-intel",
        "aarch64-apple-darwin",
    )
    for value in required:
        if value not in workflow:
            fail(f"public workflow omits allocation execution boundary: {value}")
    if "plan_release:" in workflow or "./scripts/plan-release" in workflow:
        fail("public workflow retains mutable release planning")
    if workflow.count("release-allocations/**") != 1 or workflow.count("release-recoveries/**") != 1:
        fail("public workflow does not ignore each metadata-ref namespace exactly once")
    if workflow.count("contents: write") != 1:
        fail("public workflow has more than one contents-write boundary")
    if workflow.count("fetch-depth: 0") != 2:
        fail("allocation verification jobs do not fetch complete mirror ancestry")
    if module.REPAIR_EXACT != {
        ".github/workflows/check.yml",
        "scripts/verify-release-allocation",
        "scripts/reconcile-release",
        "scripts/test-release-allocation",
    }:
        fail("public verifier recovery allowlist differs from managed allocation")


def main() -> int:
    module = load_verifier()
    prove_stable_manifest_order(module)
    prove_workflow_contract(module)
    with tempfile.TemporaryDirectory(prefix="scherzo-public-release.") as temporary:
        root = Path(temporary)
        prove_normal_execution(module, root)
        prove_partial_and_transient(module, root)
        prove_paginated_target_release(module, root)
        prove_conflicts(module, root)
        prove_recovery(module, root)
    print("Public CLI allocation verification and reconciliation checks passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
