#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  exit 0
fi

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
package_root=$public_root/src/execution/workflow/pi-json-v1-extension

cleanup() {
  rm -rf -- "$package_root/node_modules"
}
trap cleanup EXIT
cleanup

npm --prefix "$package_root" ci --ignore-scripts --no-audit --no-fund
npm_config_offline=true \
  "$package_root/node_modules/.bin/prettier" --write -- "$@"
