#!/usr/bin/env bash
set -euo pipefail

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

long_tmp_parent=$(mktemp -d)
cleanup() {
  rm -rf "$long_tmp_parent"
}
trap cleanup EXIT
long_tmp="$long_tmp_parent/portable-workflow-test-temporary-directory/with-a-deliberately-long-path/to-detect-path-length-dependent-test-fixtures"
mkdir -p "$long_tmp"
chmod 700 "$long_tmp"

"$public_root/scripts/check-structure"
"$public_root/scripts/check-pi-json-v1-extension"

cd "$public_root"
export CARGO_TERM_COLOR=never
cargo fmt --all -- --check
"$public_root/scripts/check-msrv"
cargo clippy --locked --workspace --all-targets --all-features -- -D warnings
"$public_root/scripts/check-lint-policy"
TMPDIR="$long_tmp" cargo test --locked --workspace --all-targets --all-features
TMPDIR="$long_tmp" SCHERZO_CLOUD_VERSION=0.2.7 \
  cargo test --locked --workspace --all-targets --all-features resolved_build_version
cargo build --locked --workspace --all-features --release

printf 'Public CLI source checks passed.\n'
