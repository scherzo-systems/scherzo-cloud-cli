#!/usr/bin/env python3
"""Verify one exact managed CLI release allocation without mutating GitHub."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Mapping, NoReturn, Sequence

ALLOCATION_FIELDS = (
    "contract",
    "source_revision",
    "cli_tree",
    "policy_sha256",
    "journal_sha256",
    "public_base_commit",
    "public_base_source_revision",
    "stable_refs_sha256",
    "latest_stable_tag",
    "latest_stable_commit",
    "latest_stable_source_revision",
    "latest_release_sha256",
    "release",
    "reason",
    "impact",
    "version",
    "tag",
    "changelog_sha256",
    "source_evidence_sha256",
)
RECOVERY_FIELDS = (
    "contract",
    "allocation_plan_digest",
    "allocation_ref",
    "allocation_commit",
    "allocated_mirror_commit",
    "allocated_source_revision",
    "version",
    "tag",
    "public_base_commit",
    "previous_recovery_digest",
    "repair_source_revision",
    "repair_cli_tree",
    "repair_patch_sha256",
    "repair_evidence_sha256",
)
LATEST_RELEASE_FIELDS = (
    "contract",
    "state",
    "release_id",
    "tag",
    "commit",
    "draft",
    "prerelease",
    "name_sha256",
    "body_sha256",
    "published_at_sha256",
    "assets_sha256",
)
POLICY = (
    b'schema = 2\ninitial_version = "0.1.0"\n'
    b'development_version = "0.0.0-dev"\n'
    b'pre_1_0_breaking_impact = "minor"\n'
)
ALLOCATION_PREFIX = "refs/heads/release-allocations/"
RECOVERY_PREFIX = "refs/heads/release-recoveries/"
REPAIR_EXACT = frozenset(
    {
        ".github/workflows/check.yml",
        "scripts/verify-release-allocation",
        "scripts/reconcile-release",
        "scripts/test-release-allocation",
    }
)
REPAIR_EXECUTABLE = frozenset(
    {
        ".github/workflows/check.yml",
        "scripts/verify-release-allocation",
        "scripts/reconcile-release",
    }
)
REPAIR_PREFIX = "tests/fixtures/release-notes/"
OID_RE = re.compile(r"^[0-9a-f]{40}$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
SEMVER_RE = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
TAG_RE = re.compile(r"^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
ATOM_RE = re.compile(r"^[A-Za-z0-9._/-]+$")


class VerificationError(Exception):
    """The public state does not represent the exact managed allocation."""


def fail(message: str) -> NoReturn:
    raise VerificationError(message)


def sha256(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def atom(value: str, description: str) -> str:
    if not value or ATOM_RE.fullmatch(value) is None:
        fail(f"{description} is not a canonical ASCII atom")
    return value


def oid(value: str, description: str) -> str:
    if OID_RE.fullmatch(value) is None:
        fail(f"{description} is not a lowercase SHA-1 identity")
    return value


def digest(value: str, description: str) -> str:
    if SHA256_RE.fullmatch(value) is None:
        fail(f"{description} is not a lowercase SHA-256 identity")
    return value


def semver(value: str, description: str) -> tuple[int, int, int]:
    match = SEMVER_RE.fullmatch(value)
    if match is None:
        fail(f"{description} is not canonical SemVer")
    result = tuple(int(component) for component in match.groups())
    if any(component > 999_999 for component in result):
        fail(f"{description} has a component larger than 999999")
    return result  # type: ignore[return-value]


def tag_version(value: str, description: str) -> tuple[int, int, int]:
    match = TAG_RE.fullmatch(value)
    if match is None:
        fail(f"{description} is not a canonical stable tag")
    result = tuple(int(component) for component in match.groups())
    if any(component > 999_999 for component in result):
        fail(f"{description} has a component larger than 999999")
    return result  # type: ignore[return-value]


def serialize(fields: Sequence[tuple[str, str]]) -> bytes:
    for key, value in fields:
        if re.fullmatch(r"[a-z0-9_]+", key) is None:
            fail(f"contract key is malformed: {key}")
        atom(value, f"contract field {key}")
    return "".join(f"{key}={value}\n" for key, value in fields).encode("ascii")


def parse_ordered(value: bytes, fields: Sequence[str], description: str) -> dict[str, str]:
    try:
        lines = value.decode("ascii").splitlines(keepends=True)
    except UnicodeError:
        fail(f"{description} is not ASCII")
    if len(lines) != len(fields) or any(not line.endswith("\n") for line in lines):
        fail(f"{description} has an invalid LF-terminated field count")
    parsed: dict[str, str] = {}
    for line, expected in zip(lines, fields, strict=True):
        key, separator, field_value = line[:-1].partition("=")
        if separator != "=" or key != expected:
            fail(f"{description} has an invalid ordered field: {expected}")
        parsed[key] = atom(field_value, f"{description} field {expected}")
    return parsed


def digest_manifest(entries: Mapping[str, bytes]) -> bytes:
    return b"".join(
        f"{sha256(entries[path])}  {path}\n".encode("ascii")
        for path in sorted(entries, key=os.fsencode)
    )


def expected_asset_names(version: str) -> list[str]:
    return sorted(
        [
            f"scherzo-cloud-{version}-aarch64-apple-darwin.tar.gz",
            f"scherzo-cloud-{version}-aarch64-unknown-linux-gnu.tar.gz",
            f"scherzo-cloud-{version}-x86_64-apple-darwin.tar.gz",
            f"scherzo-cloud-{version}-x86_64-unknown-linux-gnu.tar.gz",
            "SHA256SUMS",
        ],
        key=os.fsencode,
    )


@dataclass(frozen=True)
class CommitMetadata:
    subject: str
    trailers: Mapping[str, str]
    author: str
    author_email: str
    committer: str
    committer_email: str
    author_time: str
    committer_time: str


class GitRepository:
    """Read-only Git plumbing with inherited configuration disabled."""

    def __init__(self, root: Path) -> None:
        self.root = root.resolve()
        top = self.run("rev-parse", "--show-toplevel").stdout.decode("utf-8").strip()
        if Path(top).resolve() != self.root:
            fail("release verification must run from the public repository root")

    @staticmethod
    def environment() -> dict[str, str]:
        return {
            "HOME": os.environ.get("HOME", "/nonexistent"),
            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_OPTIONAL_LOCKS": "0",
        }

    def run(self, *arguments: str, check: bool = True) -> subprocess.CompletedProcess[bytes]:
        result = subprocess.run(
            [
                "git",
                "-C",
                os.fspath(self.root),
                "-c",
                "core.hooksPath=/dev/null",
                "-c",
                "core.attributesFile=/dev/null",
                "-c",
                "diff.algorithm=myers",
                "-c",
                "diff.context=3",
                "-c",
                "diff.indentHeuristic=false",
                "-c",
                "diff.interHunkContext=0",
                "-c",
                "diff.mnemonicPrefix=false",
                "-c",
                "diff.noprefix=false",
                "-c",
                "diff.orderFile=/dev/null",
                "-c",
                "diff.renames=false",
                "-c",
                "diff.submodule=short",
                *arguments,
            ],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=self.environment(),
        )
        if check and result.returncode != 0:
            fail(
                f"Git command failed ({' '.join(arguments)}): "
                + result.stderr.decode("utf-8", "replace").strip()
            )
        return result

    def rev(self, revision: str) -> str:
        value = self.run("rev-parse", f"{revision}^{{commit}}").stdout.decode("ascii").strip()
        return oid(value, revision)

    def tree(self, revision: str) -> str:
        return oid(
            self.run("rev-parse", f"{revision}^{{tree}}").stdout.decode("ascii").strip(),
            f"tree {revision}",
        )

    def blob(self, revision: str, path: str) -> bytes:
        result = self.run("cat-file", "blob", f"{revision}:{path}", check=False)
        if result.returncode != 0:
            fail(f"managed record is missing {path}")
        return result.stdout

    def parent(self, revision: str, description: str) -> str:
        commit = self.rev(revision)
        values = self.run("rev-list", "--parents", "-n", "1", commit).stdout.decode("ascii").split()
        if len(values) != 2 or values[0] != commit:
            fail(f"{description} does not have exactly one parent")
        return oid(values[1], f"{description} parent")

    def metadata(self, revision: str) -> CommitMetadata:
        raw = self.run(
            "show", "-s", "--format=%an%x00%ae%x00%cn%x00%ce%x00%at%x00%ct%x00%B", revision
        ).stdout
        values = raw.split(b"\0", 6)
        if len(values) != 7:
            fail("managed commit metadata is malformed")
        author, author_email, committer, committer_email, author_time, committer_time, message = values
        try:
            lines = message.decode("ascii").splitlines()
            identities = [part.decode("ascii") for part in values[:6]]
        except UnicodeError:
            fail("managed commit metadata is not ASCII")
        if not lines:
            fail("managed commit has no subject")
        trailers: dict[str, str] = {}
        for line in lines[1:]:
            if not line:
                continue
            key, separator, field_value = line.partition(": ")
            if separator != ": " or key in trailers:
                fail("managed commit has malformed or duplicate trailers")
            trailers[key] = atom(field_value, f"managed trailer {key}")
        return CommitMetadata(lines[0], trailers, *identities)

    def exact_files(self, revision: str) -> dict[str, tuple[str, str]]:
        raw = self.run("ls-tree", "-r", "-z", revision).stdout
        files: dict[str, tuple[str, str]] = {}
        for entry in raw.rstrip(b"\0").split(b"\0"):
            if not entry:
                continue
            metadata, raw_path = entry.split(b"\t", 1)
            mode, kind, object_id = metadata.split(b" ", 2)
            if kind != b"blob":
                fail("managed record contains a non-blob entry")
            path = os.fsdecode(raw_path)
            files[path] = (mode.decode("ascii"), object_id.decode("ascii"))
        return files

    def canonical_diff(self, base: str, candidate: str) -> bytes:
        return self.run(
            "diff",
            "--no-color",
            "--full-index",
            "--binary",
            "--no-ext-diff",
            "--no-textconv",
            "--no-renames",
            "--src-prefix=a/",
            "--dst-prefix=b/",
            base,
            candidate,
        ).stdout

    def changed_paths(self, base: str, candidate: str) -> list[str]:
        raw = self.run("diff", "--no-renames", "--name-only", "-z", base, candidate).stdout
        if raw and not raw.endswith(b"\0"):
            fail("Git returned an incomplete changed-path list")
        return [os.fsdecode(path) for path in raw.rstrip(b"\0").split(b"\0") if path]


@dataclass(frozen=True)
class Asset:
    identifier: int
    name: str
    size: int
    digest: str


class GitHub:
    """Read-only GitHub access through the workflow's short-lived gh token."""

    def __init__(self, repository: str) -> None:
        if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository) is None:
            fail("GitHub repository is malformed")
        self.repository = repository

    def run(self, *arguments: str, check: bool = True) -> subprocess.CompletedProcess[bytes]:
        environment = {
            "HOME": os.environ.get("HOME", "/nonexistent"),
            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
            "LC_ALL": "C",
        }
        for name in ("GH_TOKEN", "GITHUB_TOKEN", "GH_HOST", "GH_CONFIG_DIR", "SCHERZO_MOCK_GH_STATE"):
            if name in os.environ:
                environment[name] = os.environ[name]
        result = subprocess.run(
            ["gh", *arguments],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
        )
        if check and result.returncode != 0:
            fail(
                f"GitHub query failed ({' '.join(arguments)}): "
                + result.stderr.decode("utf-8", "replace").strip()
            )
        return result

    def api_json(self, path: str, *, missing: bool = False) -> object | None:
        result = self.run("api", path, check=False)
        if result.returncode != 0:
            diagnostic = result.stderr.decode("utf-8", "replace")
            if missing and ("HTTP 404" in diagnostic or "404 Not Found" in diagnostic):
                return None
            fail(f"GitHub query failed for {path}: {diagnostic.strip()}")
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            fail(f"GitHub returned malformed JSON for {path}")

    def release_by_tag(self, tag: str) -> Mapping[str, object] | None:
        value = self.api_json(f"repos/{self.repository}/releases/tags/{tag}", missing=True)
        if value is None:
            return None
        if not isinstance(value, dict):
            fail("GitHub release-by-tag response is not an object")
        return value

    def target_release(self, tag: str) -> Mapping[str, object] | None:
        matches: list[Mapping[str, object]] = []
        page = 1
        while True:
            value = self.api_json(
                f"repos/{self.repository}/releases?per_page=100&page={page}"
            )
            if not isinstance(value, list):
                fail("GitHub release-list response is not an array")
            matches.extend(
                item
                for item in value
                if isinstance(item, dict) and item.get("tag_name") == tag
            )
            if len(value) < 100:
                break
            page += 1
        if len(matches) > 1:
            fail("GitHub contains conflicting releases for the allocated tag")
        return matches[0] if matches else None

    def asset_bytes(self, identifier: int) -> bytes:
        return self.run(
            "api",
            "-H",
            "Accept: application/octet-stream",
            f"repos/{self.repository}/releases/assets/{identifier}",
        ).stdout


def parse_assets(document: Mapping[str, object], description: str) -> list[Asset]:
    raw_assets = document.get("assets")
    if not isinstance(raw_assets, list):
        fail(f"{description} has no asset array")
    assets: list[Asset] = []
    names: set[str] = set()
    for raw in raw_assets:
        if not isinstance(raw, dict):
            fail(f"{description} contains a malformed asset")
        identifier = raw.get("id")
        name = raw.get("name")
        size = raw.get("size")
        asset_digest = raw.get("digest")
        if (
            not isinstance(identifier, int)
            or identifier < 0
            or not isinstance(name, str)
            or re.fullmatch(r"[A-Za-z0-9._-]+", name) is None
            or not isinstance(size, int)
            or size <= 0
            or not isinstance(asset_digest, str)
            or re.fullmatch(r"sha256:[0-9a-f]{64}", asset_digest) is None
            or name in names
        ):
            fail(f"{description} contains a malformed or duplicate asset")
        names.add(name)
        assets.append(Asset(identifier, name, size, asset_digest.removeprefix("sha256:")))
    return sorted(assets, key=lambda asset: os.fsencode(asset.name))


def normalize_latest_release(
    tag: str, tag_commit: str, document: Mapping[str, object] | None
) -> bytes:
    if tag == "none":
        assets = b""
        return serialize(
            (
                ("contract", "1"),
                ("state", "none"),
                ("release_id", "none"),
                ("tag", "none"),
                ("commit", "none"),
                ("draft", "none"),
                ("prerelease", "none"),
                ("name_sha256", sha256(b"")),
                ("body_sha256", sha256(b"")),
                ("published_at_sha256", sha256(b"")),
                ("assets_sha256", sha256(assets)),
            )
        )
    if document is None:
        fail("approved latest stable tag no longer has a GitHub Release")
    release_id = document.get("id")
    name = document.get("name")
    body = document.get("body")
    published_at = document.get("published_at")
    draft_value = document.get("draft")
    prerelease_value = document.get("prerelease")
    if (
        not isinstance(release_id, int)
        or release_id < 0
        or not isinstance(name, str)
        or not isinstance(body, str)
        or not isinstance(published_at, str)
        or not published_at
        or not isinstance(draft_value, bool)
        or not isinstance(prerelease_value, bool)
        or document.get("tag_name") != tag
    ):
        fail("approved latest GitHub Release is malformed")
    assets = parse_assets(document, "approved latest GitHub Release")
    asset_manifest = b"".join(
        f"{asset.digest}  {asset.size}  {asset.name}\n".encode("ascii") for asset in assets
    )
    complete = (
        draft_value is False
        and prerelease_value is False
        and name == f"Scherzo Cloud CLI {tag}"
        and [asset.name for asset in assets] == expected_asset_names(tag.removeprefix("v"))
    )
    if not complete:
        fail("approved latest GitHub Release is no longer complete")
    try:
        published_bytes = published_at.encode("ascii")
    except UnicodeError:
        fail("approved latest GitHub Release publication time is not ASCII")
    return serialize(
        (
            ("contract", "1"),
            ("state", "complete"),
            ("release_id", str(release_id)),
            ("tag", tag),
            ("commit", tag_commit),
            ("draft", "false"),
            ("prerelease", "false"),
            ("name_sha256", sha256(name.encode("utf-8"))),
            ("body_sha256", sha256(body.encode("utf-8"))),
            ("published_at_sha256", sha256(published_bytes)),
            ("assets_sha256", sha256(asset_manifest)),
        )
    )


def parse_allocation(value: bytes) -> dict[str, str]:
    plan = parse_ordered(value, ALLOCATION_FIELDS, "allocation contract 2")
    if plan["contract"] != "2":
        fail("allocation contract differs from 2")
    for field in ("source_revision", "cli_tree", "public_base_commit", "public_base_source_revision"):
        oid(plan[field], f"allocation {field}")
    for field in (
        "policy_sha256",
        "journal_sha256",
        "stable_refs_sha256",
        "latest_release_sha256",
        "changelog_sha256",
        "source_evidence_sha256",
    ):
        digest(plan[field], f"allocation {field}")
    if plan["latest_stable_tag"] == "none":
        if plan["latest_stable_commit"] != "none" or plan["latest_stable_source_revision"] != "none":
            fail("initial allocation has inconsistent stable provenance")
    else:
        tag_version(plan["latest_stable_tag"], "allocation latest stable tag")
        oid(plan["latest_stable_commit"], "allocation latest stable commit")
        oid(plan["latest_stable_source_revision"], "allocation latest stable source")
    if plan["release"] != "true" or plan["reason"] not in {"initial-release", "releaseable-changes"}:
        fail("allocation is not release-bearing")
    if plan["impact"] not in {"patch", "minor", "major"}:
        fail("allocation impact is invalid")
    semver(plan["version"], "allocation version")
    if plan["tag"] != f"v{plan['version']}":
        fail("allocation tag does not match its version")
    return plan


def parse_recovery(value: bytes) -> dict[str, str]:
    plan = parse_ordered(value, RECOVERY_FIELDS, "recovery contract 1")
    if plan["contract"] != "1":
        fail("recovery contract differs from 1")
    for field in ("allocation_plan_digest", "repair_patch_sha256", "repair_evidence_sha256"):
        digest(plan[field], f"recovery {field}")
    if plan["previous_recovery_digest"] != "none":
        digest(plan["previous_recovery_digest"], "recovery predecessor")
    for field in (
        "allocation_commit",
        "allocated_mirror_commit",
        "allocated_source_revision",
        "public_base_commit",
        "repair_source_revision",
        "repair_cli_tree",
    ):
        oid(plan[field], f"recovery {field}")
    if plan["allocation_ref"] != ALLOCATION_PREFIX + plan["allocation_plan_digest"]:
        fail("recovery allocation ref differs from its allocation digest")
    semver(plan["version"], "recovery version")
    if plan["tag"] != f"v{plan['version']}":
        fail("recovery tag differs from its version")
    return plan


def verify_record(
    repository: GitRepository,
    commit: str,
    subject: str,
    files: Mapping[str, bytes],
) -> None:
    values = repository.run("rev-list", "--parents", "-n", "1", commit).stdout.decode("ascii").split()
    if values != [commit]:
        fail("managed release record is not an orphan commit")
    metadata = repository.metadata(commit)
    if (
        metadata.subject != subject
        or metadata.trailers
        or metadata.author != "Scherzo Release Record"
        or metadata.author_email != "noreply@scherzo.dev"
        or metadata.committer != "Scherzo Release Record"
        or metadata.committer_email != "noreply@scherzo.dev"
        or metadata.author_time != "0"
        or metadata.committer_time != "0"
    ):
        fail("managed release record metadata differs")
    actual = repository.exact_files(commit)
    if actual != {path: ("100644", actual.get(path, ("", ""))[1]) for path in files}:
        fail("managed release record layout or modes differ")
    for path, value in files.items():
        if repository.blob(commit, path) != value:
            fail(f"managed release record differs: {path}")


def read_allocation(
    repository: GitRepository, plan_digest: str, expected_commit: str
) -> tuple[dict[str, str], bytes]:
    digest(plan_digest, "allocation plan digest")
    expected_commit = oid(expected_commit, "allocation record commit")
    actual_commit = repository.rev(ALLOCATION_PREFIX + plan_digest)
    if actual_commit != expected_commit:
        fail("allocation ref does not target its bound record")
    plan_bytes = repository.blob(actual_commit, "release-plan.txt")
    if sha256(plan_bytes) != plan_digest:
        fail("allocation ref name differs from release-plan bytes")
    plan = parse_allocation(plan_bytes)
    notes = repository.blob(actual_commit, "rendered-notes.md")
    if sha256(notes) != plan["changelog_sha256"]:
        fail("allocation rendered notes differ from the plan")
    bound = {"release-plan.txt": plan_bytes, "rendered-notes.md": notes}
    files = {**bound, "files.sha256": digest_manifest(bound)}
    verify_record(repository, actual_commit, f"Reserve CLI release {plan['tag']}", files)
    return plan, notes


def read_recovery(
    repository: GitRepository, recovery_digest: str, expected_commit: str
) -> tuple[dict[str, str], bytes]:
    digest(recovery_digest, "recovery digest")
    expected_commit = oid(expected_commit, "recovery record commit")
    actual_commit = repository.rev(RECOVERY_PREFIX + recovery_digest)
    if actual_commit != expected_commit:
        fail("recovery ref does not target its bound record")
    plan_bytes = repository.blob(actual_commit, "release-recovery-plan.txt")
    if sha256(plan_bytes) != recovery_digest:
        fail("recovery ref name differs from recovery-plan bytes")
    plan = parse_recovery(plan_bytes)
    patch = repository.blob(actual_commit, "repair.patch")
    if sha256(patch) != plan["repair_patch_sha256"]:
        fail("recovery patch differs from the plan")
    bound = {"release-recovery-plan.txt": plan_bytes, "repair.patch": patch}
    files = {**bound, "files.sha256": digest_manifest(bound)}
    verify_record(repository, actual_commit, f"Reserve CLI recovery {recovery_digest}", files)
    return plan, patch


def mirror_metadata(repository: GitRepository, commit: str) -> CommitMetadata:
    metadata = repository.metadata(commit)
    if (
        metadata.author != "Scherzo Cloud Mirror"
        or metadata.author_email != "mirror@scherzo.dev"
        or metadata.committer != "Scherzo Cloud Mirror"
        or metadata.committer_email != "mirror@scherzo.dev"
    ):
        fail("public main does not use the synthetic mirror identity")
    return metadata


def verify_allocation_mirror(
    repository: GitRepository,
    allocated_mirror: str,
    plan_digest: str,
    allocation_commit: str,
    plan: Mapping[str, str],
) -> None:
    metadata = mirror_metadata(repository, allocated_mirror)
    expected = {
        "Source-Revision": plan["source_revision"],
        "Release-Plan-Digest": plan_digest,
        "Release-Allocation-Ref": ALLOCATION_PREFIX + plan_digest,
        "Release-Allocation-Commit": allocation_commit,
    }
    if metadata.subject != "Mirror CLI source" or metadata.trailers != expected:
        fail("allocated mirror metadata differs from its allocation")
    if repository.parent(allocated_mirror, "allocated mirror") != plan["public_base_commit"]:
        fail("allocated mirror parent differs from the approved public base")
    if repository.tree(allocated_mirror) != plan["cli_tree"]:
        fail("allocated mirror tree differs from the allocation")
    if repository.blob(allocated_mirror, "release.toml") != POLICY:
        fail("allocated mirror policy differs from schema 2")
    if sha256(POLICY) != plan["policy_sha256"]:
        fail("allocation policy digest differs from allocated source")
    cargo = repository.blob(allocated_mirror, "Cargo.toml")
    if re.search(rb'(?m)^version = "0\.0\.0-dev"$', cargo) is None:
        fail("allocated Cargo fallback differs from 0.0.0-dev")


def verify_repair_tree(repository: GitRepository, allocated: str, repair: str) -> bytes:
    changed = repository.changed_paths(allocated, repair)
    if not changed:
        fail("recovery mirror does not change the allocated executor")
    files = repository.exact_files(repair)
    for path in changed:
        if path not in REPAIR_EXACT and not path.startswith(REPAIR_PREFIX):
            fail(f"recovery mirror changes a non-allowlisted path: {path}")
        if path not in files:
            continue
        mode = files[path][0]
        if mode not in {"100644", "100755"}:
            fail(f"recovery mirror has an invalid mode: {path}")
        if mode == "100755" and path not in REPAIR_EXECUTABLE:
            fail(f"recovery mirror makes a forbidden path executable: {path}")
    return repository.canonical_diff(allocated, repair)


def verify_recovery_chain(
    repository: GitRepository,
    current: str,
    allocated: str,
    plan_digest: str,
    allocation_commit: str,
    allocation_plan: Mapping[str, str],
) -> str:
    current_digest = "none"
    cursor = current
    while cursor != allocated:
        metadata = mirror_metadata(repository, cursor)
        recovery_digest = digest(
            metadata.trailers.get("Release-Recovery-Digest", ""), "recovery mirror digest"
        )
        recovery_commit = oid(
            metadata.trailers.get("Release-Recovery-Commit", ""), "recovery mirror record"
        )
        recovery_plan, patch = read_recovery(repository, recovery_digest, recovery_commit)
        expected = {
            "Source-Revision": recovery_plan["repair_source_revision"],
            "Release-Plan-Digest": plan_digest,
            "Release-Allocation-Ref": ALLOCATION_PREFIX + plan_digest,
            "Release-Allocation-Commit": allocation_commit,
            "Allocated-Mirror-Commit": allocated,
            "Release-Recovery-Digest": recovery_digest,
            "Release-Recovery-Ref": RECOVERY_PREFIX + recovery_digest,
            "Release-Recovery-Commit": recovery_commit,
        }
        if metadata.subject != "Mirror CLI recovery" or metadata.trailers != expected:
            fail("recovery mirror metadata differs from its record")
        parent = repository.parent(cursor, "recovery mirror")
        if (
            recovery_plan["allocation_plan_digest"] != plan_digest
            or recovery_plan["allocation_commit"] != allocation_commit
            or recovery_plan["allocated_mirror_commit"] != allocated
            or recovery_plan["allocated_source_revision"] != allocation_plan["source_revision"]
            or recovery_plan["version"] != allocation_plan["version"]
            or recovery_plan["tag"] != allocation_plan["tag"]
            or recovery_plan["public_base_commit"] != parent
            or recovery_plan["repair_source_revision"] != metadata.trailers["Source-Revision"]
            or recovery_plan["repair_cli_tree"] != repository.tree(cursor)
        ):
            fail("recovery record changes the original allocation identity")
        if patch != verify_repair_tree(repository, allocated, cursor):
            fail("recovery patch is not the canonical allocated-mirror diff")
        previous = recovery_plan["previous_recovery_digest"]
        if parent == allocated:
            if previous != "none":
                fail("first recovery record has an unexpected predecessor")
        else:
            parent_metadata = mirror_metadata(repository, parent)
            if (
                parent_metadata.subject != "Mirror CLI recovery"
                or previous != parent_metadata.trailers.get("Release-Recovery-Digest")
            ):
                fail("recovery record does not name its immediate predecessor")
        if current_digest == "none":
            current_digest = recovery_digest
        cursor = parent
    if current_digest == "none":
        fail("workflow_dispatch recovery requires a current recovery chain")
    return current_digest


def stable_refs(repository: GitRepository) -> dict[str, str]:
    raw = repository.run(
        "for-each-ref", "--format=%(refname)", "refs/tags/"
    ).stdout.decode("ascii").splitlines()
    result: dict[str, str] = {}
    for ref in raw:
        if not ref.startswith("refs/tags/v"):
            continue
        tag = ref.removeprefix("refs/tags/")
        tag_version(tag, "public stable tag")
        result[tag] = repository.rev(ref)
    return result


def stable_manifest(refs: Mapping[str, str]) -> bytes:
    return b"".join(
        f"refs/tags/{tag}={refs[tag]}\n".encode("ascii")
        for tag in sorted(refs, key=os.fsencode)
    )


def expected_version(impact: str, latest_tag: str) -> str:
    if latest_tag == "none":
        return "0.1.0"
    major, minor, patch = tag_version(latest_tag, "allocation latest stable tag")
    if impact == "patch":
        patch += 1
    elif impact == "minor":
        minor += 1
        patch = 0
    elif impact == "major":
        major += 1
        minor = patch = 0
    else:
        fail("allocation impact is invalid")
    if max(major, minor, patch) > 999_999:
        fail("allocated version arithmetic overflowed")
    return f"{major}.{minor}.{patch}"


def verify_snapshot(
    repository: GitRepository,
    github: GitHub,
    plan: Mapping[str, str],
    allocated_mirror: str,
) -> bool:
    refs = stable_refs(repository)
    target = refs.pop(plan["tag"], None)
    if target is not None and target != allocated_mirror:
        fail("allocated stable tag targets another commit")
    if sha256(stable_manifest(refs)) != plan["stable_refs_sha256"]:
        fail("stable refs moved outside the exact allocation")
    if refs:
        latest_tag = max(refs, key=lambda tag: tag_version(tag, "public stable tag"))
        latest_commit = refs[latest_tag]
        latest_metadata = mirror_metadata(repository, latest_commit)
        latest_source = latest_metadata.trailers.get("Source-Revision", "")
        if (
            latest_metadata.subject != "Mirror CLI source"
            or latest_tag != plan["latest_stable_tag"]
            or latest_commit != plan["latest_stable_commit"]
            or latest_source != plan["latest_stable_source_revision"]
        ):
            fail("latest stable provenance differs from the allocation")
    elif any(
        plan[field] != "none"
        for field in ("latest_stable_tag", "latest_stable_commit", "latest_stable_source_revision")
    ):
        fail("initial allocation has an unexpected prior stable release")
    base_metadata = mirror_metadata(repository, plan["public_base_commit"])
    if base_metadata.trailers.get("Source-Revision") != plan["public_base_source_revision"]:
        fail("allocation public-base source identity differs")
    latest_document = (
        None
        if plan["latest_stable_tag"] == "none"
        else github.release_by_tag(plan["latest_stable_tag"])
    )
    latest_manifest = normalize_latest_release(
        plan["latest_stable_tag"], plan["latest_stable_commit"], latest_document
    )
    if sha256(latest_manifest) != plan["latest_release_sha256"]:
        fail("approved latest GitHub Release snapshot changed")
    if plan["version"] != expected_version(plan["impact"], plan["latest_stable_tag"]):
        fail("allocated version does not follow static policy arithmetic")
    expected_reason = "initial-release" if plan["latest_stable_tag"] == "none" else "releaseable-changes"
    if plan["reason"] != expected_reason:
        fail("allocation reason differs from stable provenance")
    return target is not None


@dataclass(frozen=True)
class TargetRelease:
    state: str
    document: Mapping[str, object] | None
    assets: tuple[Asset, ...]


def verify_checksums(github: GitHub, assets: Sequence[Asset], version: str) -> None:
    by_name = {asset.name: asset for asset in assets}
    downloaded: dict[str, bytes] = {}
    with tempfile.TemporaryDirectory(prefix="scherzo-published-assets.") as temporary:
        root = Path(temporary)
        for asset in assets:
            value = github.asset_bytes(asset.identifier)
            if len(value) != asset.size or sha256(value) != asset.digest:
                fail(f"published asset bytes differ from GitHub metadata: {asset.name}")
            downloaded[asset.name] = value
            path = root / asset.name
            path.write_bytes(value)
            github.run(
                "attestation",
                "verify",
                os.fspath(path),
                "--repo",
                github.repository,
            )
    checksum_bytes = downloaded["SHA256SUMS"]
    archive_names = [name for name in expected_asset_names(version) if name != "SHA256SUMS"]
    expected = b"".join(
        f"{by_name[name].digest}  {name}\n".encode("ascii")
        for name in sorted(archive_names, key=os.fsencode)
    )
    if checksum_bytes != expected:
        fail("published SHA256SUMS does not bind the exact native archives")


def verify_target_release(
    github: GitHub,
    plan: Mapping[str, str],
    notes: bytes,
    tag_exists: bool,
) -> TargetRelease:
    document = github.target_release(plan["tag"])
    if document is None:
        return TargetRelease("tag-only" if tag_exists else "absent", None, ())
    release_id = document.get("id")
    name = document.get("name")
    body = document.get("body")
    draft_value = document.get("draft")
    prerelease_value = document.get("prerelease")
    if (
        not isinstance(release_id, int)
        or release_id < 0
        or name != f"Scherzo Cloud CLI {plan['tag']}"
        or not isinstance(body, str)
        or body.encode("utf-8") != notes
        or not isinstance(draft_value, bool)
        or prerelease_value is not False
        or not tag_exists
    ):
        fail("allocated GitHub Release metadata conflicts with the exact allocation")
    assets = parse_assets(document, "allocated GitHub Release")
    expected_names = set(expected_asset_names(plan["version"]))
    actual_names = {asset.name for asset in assets}
    if not actual_names <= expected_names:
        fail("allocated GitHub Release contains an unexpected asset")
    if draft_value:
        return TargetRelease("draft", document, tuple(assets))
    if [asset.name for asset in assets] != expected_asset_names(plan["version"]):
        fail("published GitHub Release has a missing or unexpected asset")
    published_at = document.get("published_at")
    if not isinstance(published_at, str) or not published_at:
        fail("published GitHub Release has no publication identity")
    verify_checksums(github, assets, plan["version"])
    return TargetRelease("published", document, tuple(assets))


@dataclass(frozen=True)
class Verification:
    plan_digest: str
    allocation_commit: str
    allocated_mirror: str
    source_revision: str
    version: str
    tag: str
    current_main: str
    recovery_digest: str
    release_state: str
    complete: bool
    execute: bool
    plan: Mapping[str, str]
    notes: bytes
    target_release: TargetRelease

    def fields(self) -> tuple[tuple[str, str], ...]:
        return (
            ("contract", "1"),
            ("plan_digest", self.plan_digest),
            ("allocation_commit", self.allocation_commit),
            ("allocated_mirror", self.allocated_mirror),
            ("source_revision", self.source_revision),
            ("version", self.version),
            ("tag", self.tag),
            ("current_main", self.current_main),
            ("recovery_digest", self.recovery_digest),
            ("release_state", self.release_state),
            ("complete", str(self.complete).lower()),
            ("execute", str(self.execute).lower()),
        )


def current_main(repository: GitRepository) -> str:
    remote = repository.run("rev-parse", "--verify", "refs/remotes/origin/main^{commit}", check=False)
    if remote.returncode == 0:
        return oid(remote.stdout.decode("ascii").strip(), "public origin/main")
    return repository.rev("refs/heads/main")


def verify_release(
    *,
    repository_path: Path,
    allocated_input: str,
    workflow_commit: str,
    event: str,
    github_repository: str,
) -> Verification:
    repository = GitRepository(repository_path)
    github = GitHub(github_repository)
    workflow_commit = repository.rev(oid(workflow_commit, "workflow commit"))
    main = current_main(repository)
    if workflow_commit != main:
        fail("workflow code is not the current public main commit")
    main_metadata = mirror_metadata(repository, main)
    if event == "recovery" and OID_RE.fullmatch(allocated_input) is None:
        fail("workflow_dispatch recovery input must be an exact lowercase mirror commit")
    if event not in {"push", "recovery"}:
        fail("release verification event is not allowlisted")
    if main_metadata.subject == "Mirror CLI source":
        allocated_mirror = main
        if event == "recovery":
            fail("workflow_dispatch recovery requires current repaired workflow code")
        if allocated_input not in {"auto", allocated_mirror}:
            fail("normal allocation push named another allocated mirror")
        recovery_digest = "none"
        execute = True
    elif main_metadata.subject == "Mirror CLI recovery":
        allocated_mirror = oid(
            main_metadata.trailers.get("Allocated-Mirror-Commit", ""), "allocated mirror commit"
        )
        if event == "recovery" and allocated_input != allocated_mirror:
            fail("workflow_dispatch recovery input differs from the current recovery chain")
        if event == "push" and allocated_input not in {"auto", main}:
            fail("recovery-mirror push named another commit")
        recovery_digest = "pending"
        execute = event == "recovery"
    else:
        fail("public main is not an allocation or recovery mirror")
    allocated_metadata = mirror_metadata(repository, allocated_mirror)
    plan_digest = digest(
        allocated_metadata.trailers.get("Release-Plan-Digest", ""), "allocated plan digest"
    )
    allocation_commit = oid(
        allocated_metadata.trailers.get("Release-Allocation-Commit", ""),
        "allocated record commit",
    )
    plan, notes = read_allocation(repository, plan_digest, allocation_commit)
    verify_allocation_mirror(
        repository, allocated_mirror, plan_digest, allocation_commit, plan
    )
    if main != allocated_mirror:
        recovery_digest = verify_recovery_chain(
            repository,
            main,
            allocated_mirror,
            plan_digest,
            allocation_commit,
            plan,
        )
    tag_exists = verify_snapshot(repository, github, plan, allocated_mirror)
    target_release = verify_target_release(github, plan, notes, tag_exists)
    complete = target_release.state == "published"
    return Verification(
        plan_digest,
        allocation_commit,
        allocated_mirror,
        plan["source_revision"],
        plan["version"],
        plan["tag"],
        main,
        recovery_digest,
        target_release.state,
        complete,
        execute,
        plan,
        notes,
        target_release,
    )


def write_verification(result: Verification, output: Path, github_output: Path | None) -> None:
    if output.exists():
        fail("verification output path already exists")
    output.mkdir(parents=True)
    verification = serialize(result.fields())
    files = {
        "release-plan.txt": serialize(tuple((field, result.plan[field]) for field in ALLOCATION_FIELDS)),
        "rendered-notes.md": result.notes,
        "verification.txt": verification,
    }
    for name, value in files.items():
        (output / name).write_bytes(value)
    (output / "files.sha256").write_bytes(digest_manifest(files))
    if github_output is not None:
        with github_output.open("ab") as destination:
            for key, value in result.fields()[1:]:
                destination.write(f"{key}={value}\n".encode("ascii"))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--repository", type=Path, required=True)
    result.add_argument("--allocated-mirror", required=True)
    result.add_argument("--workflow-commit", required=True)
    result.add_argument("--event", choices=("push", "recovery"), required=True)
    result.add_argument("--github-repository", required=True)
    result.add_argument("--output", type=Path, required=True)
    result.add_argument("--github-output", type=Path)
    return result


def main() -> int:
    arguments = parser().parse_args()
    result = verify_release(
        repository_path=arguments.repository,
        allocated_input=arguments.allocated_mirror,
        workflow_commit=arguments.workflow_commit,
        event=arguments.event,
        github_repository=arguments.github_repository,
    )
    write_verification(result, arguments.output, arguments.github_output)
    print(
        f"Verified managed allocation {result.plan_digest} for {result.tag} "
        f"({result.release_state})."
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except VerificationError as error:
        print(f"CLI release allocation verification failed: {error}", file=sys.stderr)
        raise SystemExit(1)
