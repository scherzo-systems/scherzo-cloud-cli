#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C

fail() {
  echo "CLI release impact failed: $1" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/release-impact validate --initial-version VERSION \
    --pre-1-breaking-impact IMPACT [--latest-version VERSION] [IMPACT...]
EOF
}

[[ $# -ge 1 ]] || { usage; exit 2; }
mode=$1
shift
[[ $mode == validate ]] || { usage; exit 2; }

initial_version=
breaking_policy=
latest_version=
declare -A supplied=()
impacts=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --initial-version|--pre-1-breaking-impact|--latest-version)
      option=$1
      [[ -z ${supplied[$option]+set} && $# -ge 2 ]] || fail "$option requires one value"
      supplied[$option]=1
      value=$2
      case $option in
        --initial-version) initial_version=$value ;;
        --pre-1-breaking-impact) breaking_policy=$value ;;
        --latest-version) latest_version=$value ;;
      esac
      shift 2
      ;;
    --) shift; impacts+=("$@"); break ;;
    --*) fail "unknown option: $1" ;;
    *) impacts+=("$1"); shift ;;
  esac
done

[[ -n $initial_version ]] || fail "--initial-version is required"
[[ -n $breaking_policy ]] || fail "--pre-1-breaking-impact is required"
[[ $breaking_policy == minor ]] || fail "pre-1.0 breaking impact must be minor"
version_pattern='^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$'
[[ $initial_version =~ $version_pattern ]] \
  || fail "initial version must use canonical MAJOR.MINOR.PATCH syntax: $initial_version"
initial_major=$((10#${BASH_REMATCH[1]}))
initial_minor=$((10#${BASH_REMATCH[2]}))
initial_patch=$((10#${BASH_REMATCH[3]}))
maximum_component=999999
((initial_major <= maximum_component && initial_minor <= maximum_component \
  && initial_patch <= maximum_component)) || fail "initial version component is too large"

latest_stable_version=none
latest_major=-1
latest_minor=-1
latest_patch=-1
if [[ -n $latest_version ]]; then
  [[ $latest_version =~ $version_pattern ]] \
    || fail "latest stable version must use canonical MAJOR.MINOR.PATCH syntax: $latest_version"
  latest_major=$((10#${BASH_REMATCH[1]}))
  latest_minor=$((10#${BASH_REMATCH[2]}))
  latest_patch=$((10#${BASH_REMATCH[3]}))
  ((latest_major <= maximum_component && latest_minor <= maximum_component \
    && latest_patch <= maximum_component)) || fail "latest stable version component is too large"
  ((latest_major > initial_major \
    || latest_major == initial_major && latest_minor > initial_minor \
    || latest_major == initial_major && latest_minor == initial_minor \
      && latest_patch >= initial_patch)) \
    || fail "latest stable version precedes the initial release: $latest_version"
  latest_stable_version=$latest_version
fi

impact=none
rank=0
policy_major=$initial_major
((latest_major < 0)) || policy_major=$latest_major
for explicit in "${impacts[@]}"; do
  case $explicit in
    patch) resolved='patch'; candidate_rank=1 ;;
    minor) resolved='minor'; candidate_rank=2 ;;
    breaking)
      if ((policy_major < 1)); then
        resolved=$breaking_policy
        candidate_rank=2
      else
        resolved='major'
        candidate_rank=3
      fi
      ;;
    *) fail "unknown explicit release impact: $explicit" ;;
  esac
  if ((candidate_rank > rank)); then
    impact=$resolved
    rank=$candidate_rank
  fi
done

version=none
tag=none
if [[ $impact != none ]]; then
  if ((latest_major < 0)); then
    version=$initial_version
  else
    case $impact in
      patch)
        ((latest_patch < maximum_component)) || fail "patch release component overflow"
        version=$latest_major.$latest_minor.$((latest_patch + 1))
        ;;
      minor)
        ((latest_minor < maximum_component)) || fail "minor release component overflow"
        version=$latest_major.$((latest_minor + 1)).0
        ;;
      major)
        ((latest_major < maximum_component)) || fail "major release component overflow"
        version=$((latest_major + 1)).0.0
        ;;
    esac
  fi
  tag=v$version
fi

printf 'latest_stable_version=%s\n' "$latest_stable_version"
printf 'impact=%s\n' "$impact"
printf 'version=%s\n' "$version"
printf 'tag=%s\n' "$tag"
