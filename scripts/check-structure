#!/usr/bin/env bash
set -euo pipefail

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

required_files=(
  README.md
  ARCHITECTURE.md
  AGENTS.md
  CONTRIBUTING.md
  SECURITY.md
  LICENSE
  .config/nextest.toml
  changes/README.md
  docs/workflow-v1.md
  release.toml
  schemas/workflow-status-result-v1.schema.json
  schemas/workflow-v1.schema.json
  schemas/workflow-view-result-v1.schema.json
  tests/fixtures/workflow-view/v1/valid/success-current.json
  tests/fixtures/workflow-view/v1/valid/error-operational.json
  tests/fixtures/workflow-view/v1/valid/error-attempt.json
  tests/fixtures/workflow-view/v1/invalid/success-extra-property.json
  tests/fixtures/workflow-view/v1/invalid/success-inconsistent-outcome.json
  tests/fixtures/workflow-view/v1/invalid/error-operational-attempt-identity.json
  tests/fixtures/workflow-view/v1/invalid/error-attempt-missing-identity.json
  tests/fixtures/workflow-view/v1/invalid/error-empty-message.json
  .github/workflows/check.yml
  Cargo.toml
  Cargo.lock
  clippy.toml
  devenv.nix
  devenv.yaml
  devenv.lock
  scripts/check
  scripts/check-suite
  scripts/check-change-fragments
  scripts/check-help-output-style
  scripts/check-lint-policy
  scripts/check-msrv
  scripts/check-pi-json-v1-extension
  scripts/check-structure
  scripts/strict-devenv
  scripts/test-strict-devenv
  scripts/classify-release-path
  scripts/format-pi-json-v1-extension
  scripts/package-release-archive
  scripts/reconcile-release
  scripts/release-impact
  scripts/test-change-fragments
  scripts/test-release-allocation
  scripts/test-release-impact
  scripts/test-release-package
  scripts/test-release-path-classifier
  scripts/verify-release-allocation
  scripts/verify-release-package
  scripts/verify-release-package-isolated
  src/execution/workflow/pi-json-v1-extension/package.json
  src/execution/workflow/pi-json-v1-extension/package-lock.json
  src/execution/workflow/pi-json-v1-extension/tsconfig.json
  src/execution/workflow/pi-json-v1-extension/fixtures/generated/pi-json-v1-extension.ts
  src/execution/workflow/pi-json-v1-extension/src/pi-json-v1-extension.ts
  src/timing.rs
  tests/fixtures/lint-policy/broadly_suppressed.rs
  tests/fixtures/lint-policy/main.rs
  tests/fixtures/lint-policy/ordinary_production.rs
  tests/fixtures/lint-policy/ordinary_test.rs
)

for required_file in "${required_files[@]}"; do
  if [[ ! -s "$public_root/$required_file" ]]; then
    echo "Required public source file is missing or empty: $required_file" >&2
    exit 1
  fi
done

if ! locked_devenv_revision=$(
  jq --exit-status --raw-output '
    .nodes.devenv.locked.rev
    | strings
    | select(test("^[0-9a-f]{40}$"))
  ' "$public_root/devenv.lock"
); then
  echo "devenv.lock must contain a canonical Devenv revision." >&2
  exit 1
fi

mapfile -t workflow_devenv_installs < <(
  grep --fixed-strings \
    'nix profile add github:cachix/devenv/' \
    "$public_root/.github/workflows/check.yml" \
    || true
)
if [[ ${#workflow_devenv_installs[@]} -ne 1 ]]; then
  echo "The public check workflow must contain exactly one direct Devenv installation." >&2
  exit 1
fi
workflow_no_tui_count=$(
  grep --fixed-strings --line-regexp --count \
    '  DEVENV_TUI: "false"' \
    "$public_root/.github/workflows/check.yml" \
    || true
)
if [[ $workflow_no_tui_count -ne 1 ]]; then
  echo "The public check workflow must disable the Devenv TUI." >&2
  exit 1
fi
workflow_devenv_install=${workflow_devenv_installs[0]}
workflow_devenv_install=${workflow_devenv_install#"${workflow_devenv_install%%[![:space:]]*}"}
if [[ $workflow_devenv_install != \
  "run: nix profile add github:cachix/devenv/$locked_devenv_revision" ]]; then
  echo "The public check workflow must install the Devenv revision pinned in devenv.lock." >&2
  exit 1
fi

obsolete_workflow_schema=src/execution/workflow/workflow-v1.schema.json
if [[ -e "$public_root/$obsolete_workflow_schema" ]]; then
  echo "Obsolete internal Workflow V1 schema is present: $obsolete_workflow_schema" >&2
  exit 1
fi

if ! grep --fixed-strings --line-regexp --quiet \
  'disallowed_methods = "deny"' "$public_root/Cargo.toml"; then
  echo "Cargo must deny the checked-in disallowed timing methods by default." >&2
  exit 1
fi

symbolic_link=$(
  find "$public_root" \
    \( -name '.devenv*' -o -name .direnv -o -name node_modules -o -name target \) -prune -o \
    -type l -print -quit
)
if [[ -n "$symbolic_link" ]]; then
  echo "Symbolic links are not permitted in the public source: $symbolic_link" >&2
  exit 1
fi

while IFS= read -r -d '' script_file; do
  IFS= read -r first_line <"$script_file" || true
  if [[ $first_line =~ ^'#!'.*(ba|z|k)?sh([[:space:]]|$) ]]; then
    bash -n "$script_file"
  fi
done < <(find "$public_root/scripts" -type f -print0)

python3 - \
  "$public_root/scripts/package-release-archive" \
  "$public_root/scripts/reconcile-release" \
  "$public_root/scripts/test-release-allocation" \
  "$public_root/scripts/test-release-package" \
  "$public_root/scripts/verify-release-allocation" \
  "$public_root/scripts/verify-release-package" \
  "$public_root/scripts/verify-release-package-isolated" <<'PY'
from pathlib import Path
import sys

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    compile(path.read_text(), str(path), "exec")
PY

"$public_root/scripts/test-fixture-git"
"$public_root/scripts/test-git-isolation-check"
"$public_root/scripts/check-test-git-isolation"
"$public_root/scripts/test-change-fragments"
"$public_root/scripts/check-change-fragments"
"$public_root/scripts/test-release"
python3 "$public_root/scripts/test-release-allocation"
"$public_root/scripts/test-release-impact"
python3 "$public_root/scripts/test-release-package"
"$public_root/scripts/test-release-path-classifier"
"$public_root/scripts/check-release"

for readme_contract in \
  'scherzo-cloud workflow reference' \
  'scherzo-cloud workflow schema > workflow-v1.schema.json' \
  'https://docs.scherzo.dev/agent/workflow-authoring.md' \
  'https://docs.scherzo.dev/reference/workflow-v1.md' \
  'https://docs.scherzo.dev/schemas/workflow-v1.schema.json'; do
  if ! grep --fixed-strings --quiet -- "$readme_contract" "$public_root/README.md"; then
    echo "The public README is missing Workflow V1 guidance: $readme_contract" >&2
    exit 1
  fi
done

if ! command -v actionlint >/dev/null 2>&1; then
  echo "actionlint is required to check public release automation." >&2
  exit 1
fi
actionlint "$public_root/.github/workflows/check.yml"

workspace_manifest=$(
  cargo locate-project \
    --manifest-path "$public_root/Cargo.toml" \
    --workspace \
    --message-format plain
)
workspace_root=$(cd "$(dirname "$workspace_manifest")" && pwd)
if [[ "$workspace_root" != "$public_root" ]]; then
  echo "The Cargo workspace must be rooted inside the public source boundary: $workspace_root" >&2
  exit 1
fi

path_dependency=$(
  find "$public_root" \
    \( -name '.devenv*' -o -name .direnv -o -name node_modules -o -name target \) -prune -o \
    -name Cargo.toml -type f -exec \
      grep -HEn '(^|[,{])[[:space:]]*path[[:space:]]*=' {} + \
    | head -n 1 \
    || true
)
if [[ -n "$path_dependency" ]]; then
  echo "Cargo path dependencies are not permitted in the public source: $path_dependency" >&2
  exit 1
fi

parent_source_reference=$(
  find "$public_root/src" "$public_root/tests" -name '*.rs' -type f -exec \
    grep -HEn '(#\[path[[:space:]]*=|include(_str|_bytes)?!\()[^)]*"\.\./' {} + \
    | head -n 1 \
    || true
)
if [[ -n "$parent_source_reference" ]]; then
  echo "Rust source may not include files outside the public boundary: $parent_source_reference" >&2
  exit 1
fi

printf 'Public CLI source structure checks passed.\n'
