#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C

fail() {
  echo "Release-note rendering failed: $1" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/render-release-notes --candidate COMMIT [--latest-tag TAG]
  scripts/render-release-notes --preview [FRAGMENT...]
EOF
}

mode=
candidate=
latest_tag=
preview_paths=()
case ${1:-} in
  --candidate)
    case $# in
      2)
        mode=release
        candidate=$2
        ;;
      4)
        if [[ $3 != --latest-tag || -z $4 ]]; then
          usage
          exit 2
        fi
        mode=release
        candidate=$2
        latest_tag=$4
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  --preview)
    mode=preview
    shift
    preview_paths=("$@")
    ;;
  *)
    usage
    exit 2
    ;;
esac

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
public_root=$(cd "$script_dir/.." && pwd -P)
fragment_checker=$script_dir/check-change-fragments
[[ -x $fragment_checker ]] \
  || fail "the fragment validator is missing or not executable"

selection_root=$(mktemp -d) || fail "could not create a temporary selection directory"
trap 'rm -rf "$selection_root"' EXIT
for category in breaking added changed fixed internal; do
  mkdir -p "$selection_root/$category"
done

materialize_fragment() {
  local source_kind=$1
  local path=$2
  local category name destination source entry object_mode object_type object_id

  if [[ ! $path =~ ^changes/(breaking|added|changed|fixed|internal)/([0-9a-f]{32}[.]md)$ ]]; then
    fail "selected fragment path is invalid: $path"
  fi
  category=${BASH_REMATCH[1]}
  name=${BASH_REMATCH[2]}
  destination=$selection_root/$category/$name
  [[ ! -e $destination ]] || fail "selected fragment is duplicated: $path"

  case "$source_kind" in
    worktree)
      source=$public_root/$path
      if [[ ! -f $source || -L $source ]]; then
        fail "selected preview fragment is not a regular file: $path"
      fi
      cp -- "$source" "$destination"
      ;;
    commit)
      if ! entry=$(git ls-tree "$candidate_commit" -- "$path"); then
        fail "could not inspect selected fragment: $path"
      fi
      read -r object_mode object_type object_id _ <<<"$entry"
      if [[ $object_mode != 100644 && $object_mode != 100755 \
        || $object_type != blob || ! $object_id =~ ^[0-9a-f]{40,64}$ ]]; then
        fail "selected release fragment is not a regular file: $path"
      fi
      if ! git cat-file blob "$object_id" >"$destination"; then
        fail "could not read selected fragment: $path"
      fi
      ;;
    *)
      fail "unknown fragment source: $source_kind"
      ;;
  esac

  "$fragment_checker" --fragment "$category" "$destination" >/dev/null
}

if [[ $mode == release ]]; then
  # Resolve the public checkout from this script's location, never from an
  # enclosing Git or Jujutsu process context.
  while IFS= read -r variable; do
    unset "$variable"
  done < <(compgen -e GIT_)
  export GIT_CONFIG_GLOBAL=/dev/null
  export GIT_CONFIG_NOSYSTEM=1

  if ! repository_root=$(git -C "$public_root" rev-parse --show-toplevel 2>/dev/null); then
    fail "release mode requires a Git checkout"
  fi
  repository_root=$(cd "$repository_root" && pwd -P)
  [[ $repository_root == "$public_root" ]] \
    || fail "release mode must run from the public repository root"
  cd "$public_root"

  if ! candidate_commit=$(git rev-parse --verify "${candidate}^{commit}" 2>/dev/null); then
    fail "candidate is not a commit: $candidate"
  fi

  selected_paths=$selection_root/selected-paths
  if [[ -n $latest_tag ]]; then
    if [[ ! $latest_tag =~ ^v(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$ ]]; then
      fail "latest stable tag must use canonical vMAJOR.MINOR.PATCH syntax: $latest_tag"
    fi
    if ! latest_commit=$(
      git rev-parse --verify "refs/tags/${latest_tag}^{commit}" 2>/dev/null
    ); then
      fail "latest stable tag does not identify a commit: $latest_tag"
    fi
    if ! git merge-base --is-ancestor "$latest_commit" "$candidate_commit"; then
      fail "latest stable tag is not an ancestor of the candidate: $latest_tag"
    fi

    changed_released_paths=$selection_root/changed-released-paths
    if ! git diff \
      --no-renames \
      --name-only \
      --diff-filter=DMT \
      -z \
      "$latest_commit" \
      "$candidate_commit" \
      -- changes >"$changed_released_paths"; then
      fail "could not verify released fragments after $latest_tag"
    fi
    while IFS= read -r -d '' path; do
      if [[ $path =~ ^changes/(breaking|added|changed|fixed|internal)/[0-9a-f]{32}[.]md$ ]]; then
        fail "released fragment changed or was removed after $latest_tag: $path"
      fi
    done <"$changed_released_paths"

    if ! git diff \
      --no-renames \
      --name-only \
      --diff-filter=A \
      -z \
      "$latest_commit" \
      "$candidate_commit" \
      -- changes >"$selected_paths"; then
      fail "could not select fragments after $latest_tag"
    fi
  else
    if ! git ls-tree \
      -r \
      --name-only \
      -z \
      "$candidate_commit" \
      -- changes >"$selected_paths"; then
      fail "could not select fragments from the initial release"
    fi
  fi

  while IFS= read -r -d '' path; do
    case "$path" in
      changes/breaking/*.md|changes/added/*.md|changes/changed/*.md|changes/fixed/*.md|changes/internal/*.md)
        materialize_fragment commit "$path"
        ;;
    esac
  done <"$selected_paths"
else
  for path in "${preview_paths[@]}"; do
    materialize_fragment worktree "$path"
  done
fi

rendered_section=0
render_category() {
  local category=$1
  local heading=$2
  local fragment_list=$selection_root/$category.list
  local fragment content

  find "$selection_root/$category" -maxdepth 1 -type f -print0 \
    | sort -z >"$fragment_list"
  [[ -s $fragment_list ]] || return 0

  if [[ $rendered_section -eq 1 ]]; then
    printf '\n'
  fi
  printf '## %s\n\n' "$heading"
  while IFS= read -r -d '' fragment; do
    IFS= read -r content <"$fragment"
    printf -- '- %s\n' "$content"
  done <"$fragment_list"
  rendered_section=1
}

render_category breaking 'Breaking changes'
render_category added 'Added'
render_category changed 'Changed'
render_category fixed 'Fixed'
