#!/usr/bin/env bash
set -euo pipefail

# This is an operator-assisted test for a dedicated host. It deliberately suspends the
# machine and arranges a relative wake; do not run it on a shared or production host.
readonly linux_direct_timer_due_seconds=10
readonly linux_direct_wake_after_seconds=20
readonly macos_direct_timer_due_seconds=15
readonly macos_direct_wake_after_seconds=25
readonly external_timer_due_seconds=120
readonly external_wake_after_seconds=130
readonly prompt_wake_limit_seconds=5
readonly external_wait_limit_seconds=600

platform=$(uname -s)
architecture=$(uname -m)

external_suspend=false
case ${1:-} in
  "") ;;
  --external-suspend)
    external_suspend=true
    shift
    ;;
  *)
    echo "Usage: $0 [--external-suspend]" >&2
    exit 2
    ;;
esac
if (($# != 0)); then
  echo "Usage: $0 [--external-suspend]" >&2
  exit 2
fi

external_ready_file=
if [[ $external_suspend == true ]]; then
  readonly timer_due_seconds=$external_timer_due_seconds
  readonly wake_after_seconds=$external_wake_after_seconds
  external_ready_file=${SCHERZO_LEASE_SUSPEND_EXTERNAL_READY_FILE:-}
  if [[ $external_ready_file != /* ]]; then
    echo "SCHERZO_LEASE_SUSPEND_EXTERNAL_READY_FILE must be an absolute path in external suspend mode." >&2
    exit 1
  fi
  if [[ -e $external_ready_file || -L $external_ready_file ]]; then
    echo "SCHERZO_LEASE_SUSPEND_EXTERNAL_READY_FILE must not already exist." >&2
    exit 1
  fi
else
  if [[ $platform == Darwin ]]; then
    readonly timer_due_seconds=$macos_direct_timer_due_seconds
    readonly wake_after_seconds=$macos_direct_wake_after_seconds
  else
    readonly timer_due_seconds=$linux_direct_timer_due_seconds
    readonly wake_after_seconds=$linux_direct_wake_after_seconds
  fi
fi

case "$platform" in
  Linux)
    if [[ $external_suspend == true ]]; then
      suspend_description="externally coordinated state-preserving suspend for at least $wake_after_seconds seconds"
    else
      suspend_tool=$(command -v rtcwake || true)
      if [[ -z "$suspend_tool" ]]; then
        echo "rtcwake is required for the Linux suspend probe." >&2
        exit 1
      fi
      suspend_description="rtcwake -m mem -s $wake_after_seconds"
    fi
    ;;
  Darwin)
    if [[ $external_suspend == true ]]; then
      echo "External suspend coordination is supported for Linux only." >&2
      exit 1
    fi
    if [[ "$architecture" != arm64 ]]; then
      echo "The macOS suspend probe requires a native ARM64 host." >&2
      exit 1
    fi
    suspend_tool=/usr/bin/pmset
    if [[ ! -x "$suspend_tool" ]]; then
      echo "pmset is required for the macOS suspend probe." >&2
      exit 1
    fi
    suspend_description="pmset relative wake $wake_after_seconds; pmset sleepnow"
    ;;
  *)
    echo "The suspend-aware runner lease probe supports Linux and macOS only." >&2
    exit 1
    ;;
esac

privileged=()
if [[ $external_suspend == false && ${EUID:-$(id -u)} -ne 0 ]]; then
  sudo_tool=$(command -v sudo || true)
  if [[ -z "$sudo_tool" ]]; then
    echo "sudo or a root shell is required to suspend this dedicated host." >&2
    exit 1
  fi
  "$sudo_tool" -v
  privileged=("$sudo_tool")
fi

printf 'Lease suspend probe platform: %s\n' "$platform"
printf 'Lease suspend probe architecture: %s\n' "$architecture"
printf 'Lease suspend command: %s\n' "$suspend_description"
printf 'Lease timer due after: %s seconds\n' "$timer_due_seconds"
printf 'Scheduled wake after: %s seconds\n' "$wake_after_seconds"

# Compile and run every deterministic/native smoke case before arming the real-suspend case.
cargo test --quiet --locked lease_clock -- --nocapture

probe_root=$(mktemp -d)
if [[ $external_suspend == true ]]; then
  ready_file=$external_ready_file
else
  ready_file="$probe_root/ready"
fi
probe_log="$probe_root/probe.log"
probe_pid=

probe_is_running() {
  local pid=$1 state process_stat
  kill -0 "$pid" 2>/dev/null || return 1
  case "$platform" in
    Linux)
      [[ -r "/proc/$pid/stat" ]] || return 1
      process_stat=$(<"/proc/$pid/stat")
      if [[ $process_stat =~ ^[0-9]+\ \(.*\)\ ([^[:space:]]) ]]; then
        [[ ${BASH_REMATCH[1]} != Z ]] || return 1
      fi
      ;;
    Darwin)
      state=$(/bin/ps -o state= -p "$pid" 2>/dev/null) || return 1
      state=${state//[[:space:]]/}
      [[ -n $state && $state != Z* ]] || return 1
      ;;
  esac
}

terminate_probe() {
  local deadline
  [[ -n "$probe_pid" ]] || return 0
  if probe_is_running "$probe_pid"; then
    kill "$probe_pid" 2>/dev/null || true
    deadline=$((SECONDS + 5))
    while probe_is_running "$probe_pid" && ((SECONDS < deadline)); do
      # ast-grep-ignore: no-shell-test-sleep -- bounded cleanup observes the external Cargo child before escalating to SIGKILL.
      sleep 0.1
    done
  fi
  if probe_is_running "$probe_pid"; then
    kill -KILL "$probe_pid" 2>/dev/null || true
    deadline=$((SECONDS + 5))
    while probe_is_running "$probe_pid" && ((SECONDS < deadline)); do
      # ast-grep-ignore: no-shell-test-sleep -- bounded cleanup observes delivery of SIGKILL to the external Cargo child.
      sleep 0.1
    done
  fi
  if probe_is_running "$probe_pid"; then
    echo "The lease probe child did not terminate after SIGKILL." >&2
    probe_pid=
    return 0
  fi
  # ast-grep-ignore: no-shell-test-unbounded-wait -- probe_is_running confirmed the child exited, so wait only reaps its status.
  wait "$probe_pid" 2>/dev/null || true
  probe_pid=
}

cleanup() {
  terminate_probe
  if [[ -n "$external_ready_file" ]]; then
    rm -f -- "$external_ready_file"
  fi
  rm -rf "$probe_root"
}
trap cleanup EXIT INT TERM

SCHERZO_LEASE_SUSPEND_READY_FILE="$ready_file" \
  SCHERZO_LEASE_SUSPEND_DUE_SECONDS="$timer_due_seconds" \
  cargo test --quiet --locked lease_clock_real_suspend_probe -- --ignored --nocapture \
  >"$probe_log" 2>&1 &
probe_pid=$!

# The readiness marker crosses a process and kernel-resource boundary, so no direct
# synchronization primitive is available to this shell. Poll only as a bounded anti-hang guard.
for _ in {1..600}; do
  if [[ -s "$ready_file" ]]; then
    break
  fi
  if ! probe_is_running "$probe_pid"; then
    # ast-grep-ignore: no-shell-test-unbounded-wait -- probe_is_running confirmed the child exited, so wait only collects its status.
    wait "$probe_pid" || true
    probe_pid=
    cat "$probe_log" >&2
    echo "The lease probe exited before its native timer was armed." >&2
    exit 1
  fi
  # ast-grep-ignore: no-shell-test-sleep -- bounded polling observes the native timer's cross-process readiness file.
  sleep 0.1
done
if [[ ! -s "$ready_file" ]]; then
  cat "$probe_log" >&2
  echo "The lease probe did not arm its native timer within 60 seconds." >&2
  exit 1
fi

suspend_command_elapsed=
if [[ $external_suspend == true ]]; then
  printf 'External suspend readiness: ready\n'
  for ((attempt = 0; attempt < external_wait_limit_seconds * 10; attempt++)); do
    if ! probe_is_running "$probe_pid"; then
      break
    fi
    # ast-grep-ignore: no-shell-test-sleep -- bounded polling waits for the trusted operator to suspend and resume the dedicated host.
    sleep 0.1
  done
  if probe_is_running "$probe_pid"; then
    cat "$probe_log" >&2
    echo "The externally coordinated lease probe did not finish within $external_wait_limit_seconds seconds." >&2
    exit 1
  fi
else
  suspend_started=$SECONDS
  case "$platform" in
    Linux)
      "${privileged[@]}" "$suspend_tool" -m mem -s "$wake_after_seconds"
      ;;
    Darwin)
      "${privileged[@]}" "$suspend_tool" relative wake "$wake_after_seconds"
      "${privileged[@]}" "$suspend_tool" sleepnow
      ;;
  esac
  suspend_command_elapsed=$((SECONDS - suspend_started))

  # Linux rtcwake returns after resume, so five seconds is a direct post-resume bound. Current
  # macOS pmset returns after requesting asynchronous sleep; allow that request to reach system
  # sleep before applying the same native probe assertions and operator-observed wake bound.
  if [[ $platform == Darwin ]]; then
    completion_attempts=60
    completion_poll_seconds=1
  else
    completion_attempts=50
    completion_poll_seconds=0.1
  fi
  for ((attempt = 0; attempt < completion_attempts; attempt++)); do
    if ! probe_is_running "$probe_pid"; then
      break
    fi
    # ast-grep-ignore: no-shell-test-sleep -- bounded polling observes asynchronous system sleep and native post-resume probe completion.
    sleep "$completion_poll_seconds"
  done
  if probe_is_running "$probe_pid"; then
    cat "$probe_log" >&2
    echo "The lease probe did not complete after the requested suspend and resume." >&2
    exit 1
  fi
fi

set +e
# ast-grep-ignore: no-shell-test-unbounded-wait -- probe_is_running confirmed the child exited, so wait only collects its status.
wait "$probe_pid"
probe_status=$?
set -e
probe_pid=
if [[ $probe_status -ne 0 ]]; then
  cat "$probe_log" >&2
  echo "The native lease suspend probe failed." >&2
  exit "$probe_status"
fi

observation=$(grep --fixed-strings 'lease suspend probe:' "$probe_log" || true)
if [[ -z "$observation" ]]; then
  cat "$probe_log" >&2
  echo "The native lease suspend probe produced no sanitized observation." >&2
  exit 1
fi

if [[ $external_suspend == true ]]; then
  printf 'External suspend coordination: completed\n'
else
  printf 'Suspend command relative duration: %s seconds\n' "$suspend_command_elapsed"
fi
printf '%s\n' "$observation"
if [[ $external_suspend == false ]]; then
  printf 'Prompt post-resume completion: within %s seconds\n' "$prompt_wake_limit_seconds"
fi
printf 'Runner lease suspend probe passed.\n'
