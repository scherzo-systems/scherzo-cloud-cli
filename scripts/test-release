#!/usr/bin/env bash
set -euo pipefail

fail() { echo "$1" >&2; exit 1; }
[[ $# -eq 0 ]] || { echo 'Usage: scripts/test-release' >&2; exit 2; }
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT
fixture=$root/fixture
mkdir -p "$fixture/scripts"
cp "$script_dir/check-release" "$fixture/scripts/"
chmod +x "$fixture/scripts/check-release"
checker=$fixture/scripts/check-release

write_policy() {
  cat >"$fixture/release.toml" <<'EOF'
schema = 2
initial_version = "0.1.0"
development_version = "0.0.0-dev"
pre_1_0_breaking_impact = "minor"
EOF
}
write_manifest() {
  cat >"$fixture/Cargo.toml" <<EOF
[package]
name = "fixture"
version = "$1"
EOF
}
reset_fixture() { write_policy; write_manifest "${1:-0.0.0-dev}"; }
expect_output() {
  local expected=$1; shift
  local output
  output=$("$@" 2>&1) || fail "expected success, got: $output"
  [[ $output == "$expected" ]] || fail "expected '$expected', got '$output'"
}
expect_failure() {
  local description=$1; shift
  "$@" >/dev/null 2>&1 && fail "$description: expected failure"
  return 0
}

reset_fixture
expect_output 'CLI static release policy is valid.' "$checker"
expect_output '0.1.0' "$checker" --initial-version
expect_output '0.0.0-dev' "$checker" --development-version
expect_output 'minor' "$checker" --breaking-impact
expect_output 'CLI release tag is valid: v99.42.7.' "$checker" --validate-tag v99.42.7

reset_fixture
rm "$fixture/release.toml"
expect_failure 'missing policy' "$checker"

for mutation in \
  'schema = 1' \
  'initial_version = "0.2.0"' \
  'development_version = "0.1.0"' \
  'pre_1_0_breaking_impact = "major"'; do
  reset_fixture
  key=${mutation%% =*}
  case $key in
    schema) line=1 ;;
    initial_version) line=2 ;;
    development_version) line=3 ;;
    pre_1_0_breaking_impact) line=4 ;;
  esac
  awk -v line="$line" -v mutation="$mutation" 'NR == line { print mutation; next } { print }' \
    "$fixture/release.toml" >"$fixture/release.toml.next"
  mv "$fixture/release.toml.next" "$fixture/release.toml"
  expect_failure "invalid static field $key" "$checker"
done

reset_fixture
printf '%s\n' 'series = "0.11"' >>"$fixture/release.toml"
expect_failure 'mutable series field' "$checker"

reset_fixture 0.11.0
expect_failure 'Cargo fallback mismatch' "$checker"

reset_fixture
cat >"$fixture/Cargo.toml" <<'EOF'
[package]
name = "fixture"
EOF
expect_failure 'missing Cargo package version' "$checker"

for tag in 0.1.0 v0.1 v01.1.0 v0.1.0-beta; do
  reset_fixture
  expect_failure "malformed tag $tag" "$checker" --validate-tag "$tag"
done
reset_fixture
expect_failure 'oversized tag' "$checker" --validate-tag v0.1.1000000

printf 'CLI release checks passed.\n'
