#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "$1" >&2
  exit 1
}

if [[ $# -ne 0 ]]; then
  echo "Usage: scripts/test-release-planner" >&2
  exit 2
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
fixture_git=$script_dir/fixture-git
test_root=$($fixture_git new-root)
trap 'rm -rf "$test_root"' EXIT
fixture=$test_root/fixture
planner_redirected_git=$test_root/planner-redirected.git
planner_redirected_worktree=$test_root/planner-redirected-worktree
source_one=1111111111111111111111111111111111111111
source_two=2222222222222222222222222222222222222222
source_three=3333333333333333333333333333333333333333
source_four=4444444444444444444444444444444444444444
source_five=5555555555555555555555555555555555555555
source_six=6666666666666666666666666666666666666666

write_release() {
  local series=$1
  cat >"$fixture/release.toml" <<EOF
schema = 1
series = "$series"
EOF
  cat >"$fixture/Cargo.toml" <<EOF
[package]
name = "fixture"
version = "${series}.0"
EOF
}

write_fragment() {
  local category=$1
  local identifier=$2
  local content=$3
  mkdir -p "$fixture/changes/$category"
  printf '%s\n' "$content" >"$fixture/changes/$category/$identifier.md"
}

fixture_repository_git() {
  "$fixture_git" worktree "$test_root" "$fixture" "$@"
}

commit_mirror() {
  local source_revision=$1
  fixture_repository_git add --all
  fixture_repository_git commit --quiet \
    --message="Mirror CLI source" \
    --message="Source-Revision: $source_revision"
}

plan_field() {
  local output=$1
  local name=$2
  awk -F= -v name="$name" '$1 == name { print $2 }' <<<"$output"
}

expect_plan() {
  local expected_release=$1
  local expected_reason=$2
  local expected_impact=$3
  local expected_series=$4
  local expected_version=$5
  local expected_tag=$6
  local expected_latest_tag=$7
  local expected_source=$8
  local expected_approved_digest=${9:-none}
  local output mirror_commit
  mirror_commit=$(fixture_repository_git rev-parse HEAD)
  if ! output=$(
    GIT_DIR="$planner_redirected_git" \
    GIT_WORK_TREE="$planner_redirected_worktree" \
      "$fixture/scripts/plan-release" 2>&1
  ); then
    fail "Expected release plan success, got failure: $output"
  fi
  [[ $(wc -l <<<"$output" | tr -d '[:space:]') == 13 ]] \
    || fail "Release plan did not emit its exact 13-field contract: $output"
  for expectation in \
    "release=$expected_release" \
    "reason=$expected_reason" \
    "impact=$expected_impact" \
    "series=$expected_series" \
    "version=$expected_version" \
    "tag=$expected_tag" \
    "latest_tag=$expected_latest_tag" \
    "mirror_commit=$mirror_commit" \
    "source_revision=$expected_source"; do
    name=${expectation%%=*}
    expected=${expectation#*=}
    actual=$(plan_field "$output" "$name")
    [[ $actual == "$expected" ]] \
      || fail "Expected $expectation, found $name=$actual in: $output"
  done
  plan_digest=$(plan_field "$output" plan_digest)
  [[ $plan_digest =~ ^[0-9a-f]{64}$ ]] || fail "Release plan digest is malformed."
  changelog_sha=$(plan_field "$output" changelog_sha256)
  [[ $changelog_sha =~ ^[0-9a-f]{64}$ ]] || fail "Changelog digest is malformed."
  [[ $(plan_field "$output" approved_digest) == "$expected_approved_digest" ]] \
    || fail "Release plan did not preserve the expected managed approval digest."
}

expect_failure() {
  local expected=$1
  local output
  if output=$(
    GIT_DIR="$planner_redirected_git" \
    GIT_WORK_TREE="$planner_redirected_worktree" \
      "$fixture/scripts/plan-release" 2>&1
  ); then
    fail "Expected planner failure containing '$expected', got success: $output"
  fi
  [[ $output == *"$expected"* ]] \
    || fail "Expected planner failure containing '$expected', got: $output"
}

expect_rejection() {
  local description=$1
  local output
  if output=$(
    GIT_DIR="$planner_redirected_git" \
    GIT_WORK_TREE="$planner_redirected_worktree" \
      "$fixture/scripts/plan-release" 2>&1
  ); then
    fail "$description: expected rejection, got success: $output"
  fi
}

mkdir -p "$fixture/scripts" "$fixture/src" "$fixture/changes"
for helper in \
  check-change-fragments \
  check-release \
  classify-release-path \
  plan-release \
  release-impact \
  render-release-notes; do
  cp "$script_dir/$helper" "$fixture/scripts/$helper"
done
chmod +x "$fixture/scripts/"*
cp "$script_dir/../changes/README.md" "$fixture/changes/README.md"
write_release 0.1
printf 'fn main() {}\n' >"$fixture/src/main.rs"
printf '# Fixture\n' >"$fixture/README.md"
write_fragment internal aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 'No user-visible changes.'
"$fixture_git" init-worktree "$test_root" "$fixture"
fixture_repository_git config user.name "Scherzo Cloud Mirror"
fixture_repository_git config user.email "mirror@scherzo.dev"
commit_mirror "$source_one"

expect_plan true initial-release patch 0.1 0.1.0 v0.1.0 none "$source_one"

fixture_repository_git update-ref refs/tags/v0.1.0 HEAD
expect_plan false already-released patch 0.1 0.1.0 v0.1.0 v0.1.0 "$source_one"

printf '\nDocumentation only.\n' >>"$fixture/README.md"
commit_mirror "$source_two"
expect_plan false no-releaseable-changes none 0.1 none none v0.1.0 "$source_two"

printf 'fn fixed() {}\n' >>"$fixture/src/main.rs"
write_fragment fixed bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb 'Fix fixture release planning.'
commit_mirror "$source_three"
expect_plan true releaseable-changes patch 0.1 0.1.1 v0.1.1 v0.1.0 "$source_three"

fixture_repository_git update-ref refs/tags/v0.2.0 HEAD
expect_rejection "semantically inconsistent tag"
fixture_repository_git update-ref -d refs/tags/v0.2.0

fixture_repository_git update-ref refs/tags/v0.1.1 HEAD
write_release 0.2
printf 'fn added() {}\n' >>"$fixture/src/main.rs"
write_fragment added cccccccccccccccccccccccccccccccc 'Add semantic fixture planning.'
commit_mirror "$source_four"
expect_plan true releaseable-changes minor 0.2 0.2.0 v0.2.0 v0.1.1 "$source_four"

printf 'fn accumulated() {}\n' >>"$fixture/src/main.rs"
write_fragment added dddddddddddddddddddddddddddddddd 'Add another semantic fixture capability.'
commit_mirror "$source_five"
expect_plan true releaseable-changes minor 0.2 0.2.0 v0.2.0 v0.1.1 "$source_five"
approved_output=$("$fixture/scripts/plan-release")
approved_digest=$(plan_field "$approved_output" plan_digest)
fixture_repository_git commit --amend --quiet \
  --message="Mirror CLI source" \
  --message="Source-Revision: $source_five
Release-Plan-Digest: $approved_digest"
expect_plan \
  true releaseable-changes minor 0.2 0.2.0 v0.2.0 v0.1.1 "$source_five" "$approved_digest"

mismatched_digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
fixture_repository_git commit --amend --quiet \
  --message="Mirror CLI source" \
  --message="Source-Revision: $source_five
Release-Plan-Digest: $mismatched_digest"
expect_rejection "valid but mismatched approved release-plan digest"
fixture_repository_git commit --amend --quiet \
  --message="Mirror CLI source" \
  --message="Source-Revision: $source_five
Release-Plan-Digest: $approved_digest"
fixture_repository_git update-ref refs/tags/v0.2.0 HEAD
expect_plan \
  false already-released minor 0.2 0.2.0 v0.2.0 v0.2.0 "$source_five" "$approved_digest"

fixture_repository_git update-ref refs/tags/v01.0.0 HEAD
expect_failure "CLI release tag must use canonical vMAJOR.MINOR.PATCH syntax: v01.0.0"
fixture_repository_git update-ref -d refs/tags/v01.0.0

fixture_repository_git switch --quiet --create divergent v0.1.1
printf '\nDivergent documentation.\n' >>"$fixture/README.md"
commit_mirror "$source_six"
fixture_repository_git update-ref refs/tags/v0.1.9 HEAD
fixture_repository_git switch --quiet main
expect_failure "CLI release tag is not an ancestor of the current mirror commit: v0.1.9"
fixture_repository_git update-ref -d refs/tags/v0.1.9
fixture_repository_git branch --delete --force divergent >/dev/null

printf '\nMissing source trailer.\n' >>"$fixture/README.md"
fixture_repository_git add README.md
fixture_repository_git commit --quiet --message="Mirror CLI source"
expect_failure "Current mirror commit must contain one canonical Source-Revision trailer."

[[ ! -e $planner_redirected_git ]] \
  || fail "CLI release planner trusted an inherited Git repository context."
printf 'CLI release planner checks passed.\n'
