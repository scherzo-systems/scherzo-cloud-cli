{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project facts",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "launch_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "primary_risk": {
      "type": "string",
      "minLength": 1
    },
    "mitigation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["project_name", "owner", "launch_date", "primary_risk", "mitigation"],
  "additionalProperties": false
}
