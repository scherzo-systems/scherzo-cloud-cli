{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "No value can satisfy both bounds; this schema intentionally rejects every result.",
  "type": "object",
  "properties": {
    "value": {
      "type": "integer",
      "minimum": 1,
      "maximum": 0
    }
  },
  "required": ["value"],
  "additionalProperties": false
}
